-- Generated by psx from Counter.psx
module React.Examples.Counter (main) where
import Prelude
import Effect (Effect)
import React.Basic.DOM (css)
import React.Basic.Hooks.Psx (Markup, root)
import React.Basic.Hooks.Psx as B
import Suite.React as React
view :: (Unit -> Effect Unit) -> Int -> Markup (Effect Unit)
view dispatch count =
  [ B.section [ B.styleAttr (css { color: "darkslategray" }) ] ([
    B.h1 [] ([ B.text "React with PSX" ]),
    B.p [ B.attribute "data-testid" "count" ] (B.children (show count)),
    B.button [ B.attribute "data-testid" "increment", B.onClick (dispatch unit) ] ([ B.text "Increment" ]),
    B.input [ B.attribute "data-testid" "controlled", B.value (show count), B.readonly true ] B.none,
    B.ul [] (B.children (
       map (\name -> [ B.keyed (name) (B.li [ B.attribute "data-testid" ("row-" <> name) ] (B.children (name))) ])
        (if mod count 2 == 0 then [ "a", "b" ] else [ "b", "a" ]))
   ),
    B.svg [ B.viewBox "0 0 10 10" ] ([ B.circle [ B.cx "5", B.cy "5", B.r "4" ] B.none ]) ]
   ) ]

main :: Effect Unit
main = React.mount 0 (\count _ -> count + 1) (\dispatch count -> root (view dispatch count))
