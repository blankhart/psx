<script type="text/purescript">
-- | A counter: the smallest Screamer component. Screamer's own HelloWorld
-- | example, with its view in PSX.
module Screamer.Examples.HelloWorld where

import Prelude

import Effect (Effect)
import Effect.Class (liftEffect)
import Screamer.Examples.Harness as Harness
import Screamer.Core (Element, component)
import Screamer.Psx (Markup, root)
import Screamer.SignalSource (SignalSource, signalSource)

main :: Effect Unit
main = Harness.run "main" counter

counter :: Element
counter = component do
  count <- liftEffect $ signalSource 0
  pure $ root (view count)

foreign import view :: SignalSource Int -> Markup (Effect Unit)
</script>

<template head="view count">
  <div class="counter">
    <button id="decrement" onclick={count.modify (_ - 1)}>-</button>
    <span id="count">{show <$> count.signal}</span>
    <button id="increment" onclick={count.modify (_ + 1)}>+</button>
  </div>
</template>
