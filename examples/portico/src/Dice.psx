module Examples.Dice where

import Prelude

import Data.Maybe (Maybe(..))
import Data.Tuple (Tuple(..))
import Effect (Effect)
import Effect.Class (liftEffect)
import Effect.Random as Random
import Portico as P
import Portico.Psx (Markup, root)

-- The effects this application can ask for, as data, so that a test can check
-- what `update` asked for without running it. See test/Main.purs.
data Cmd = RollDie

derive instance eqCmd :: Eq Cmd

instance showCmd :: Show Cmd where
  show RollDie = "RollDie"

interpret :: Cmd -> P.Sub Msg
interpret RollDie = \send -> liftEffect $ send <<< Update =<< Random.randomInt 1 6

type Model = Maybe Int

data Msg = Roll | Update Int

update :: Model -> Msg -> Tuple Model (Array Cmd)
update model = case _ of
  Roll -> Tuple model [ RollDie ]
  Update int -> Tuple (Just int) []

view :: Model -> Markup Msg
view model =
  <main id="main">
    {show model}
    <button onclick={Roll}>Roll</button>
  </main>

main :: Effect Unit
main =
  void $ P.mountWithOptions (P.defaultOptions { interpret = interpret, devtools = true }) "main"
    { init: Tuple Nothing []
    , update
    , subscriptions: P.noSubscriptions
    , view: root <<< view
    }
