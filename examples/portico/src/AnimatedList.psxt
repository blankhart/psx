<script type="text/purescript">
module Examples.AnimatedList where

import Prelude

import Data.Array as Array
import Data.Maybe as Maybe
import Data.Tuple (Tuple(..))
import Data.Unfoldable (replicateA)
import Effect (Effect)
import Effect.Random as Random
import Portico ((:>))
import Portico as P
import Portico.Psx (Key, Markup, Node, keyedChildren, keyedElement, root)

type Model =
  { next :: Int
  , values :: Array Int
  }

init :: P.Init Model Msg
init = { next: 1, values: [] } :> []

data Msg = Add | Remove Int | Shuffle | Update (Array Int)

update :: P.Update Model Msg
update model = case _ of
  Add ->
    model { values = Array.snoc model.values model.next, next = model.next + 1 } :> []
  Remove index ->
    model { values = Array.deleteAt index model.values # Maybe.fromMaybe model.values } :> []
  Shuffle ->
    model :>
      [ do
          P.sync $ Update <$> shuffle model.values
      ]
  Update values ->
    model { values = values } :> []

shuffle :: Array Int -> Effect (Array Int)
shuffle array = do
  let length = Array.length array
  randoms <- replicateA length $ Random.randomInt 0 (length - 1)
  pure $ array # Array.zip randoms # Array.sortWith (\(Tuple a _) -> a) # map (\(Tuple _ b) -> b)

foreign import view :: Model -> Markup Msg

-- | One value in the list, keyed by itself.
foreign import item :: Int -> Int -> Array (Tuple Key (Node Msg))

main :: Effect Unit
main = do
  void $ P.mount "main" { init, update, subscriptions: P.noSubscriptions, view: root <<< view }
</script>

<!--
  A transition group is a Portico trait with no HTML attribute, so the list
  is Portico's own keyed element in a hole, over keyed literals.
-->
<template name="view" args="model">
  <main id="main">
    <button onclick={Add}>Add</button>
    <button onclick={Shuffle}>Shuffle</button>
    {keyedElement "div" [ P.transitionGroup "bounce", P.class' "list" ]
      (keyedChildren (Array.mapWithIndex item model.values))
    }
  </main>
</template>

<template name="item" args="index value">
  <div key={show value} onclick={Remove index}>{show value}</div>
</template>

<style>
  :scope {
    width: 500px;
    margin: 2rem auto;
  }

  .list {
    display: flex;
    flex-wrap: wrap;
  }

  .list > * {
    width: 50px;
    height: 50px;
    margin: 10px;
    background: crimson;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bounce-enter-active {
    animation: bounce-in 0.5s;
  }

  .bounce-leave-active {
    animation: bounce-in 0.5s reverse;
  }

  .bounce-move {
    transition: 0.5s all;
  }

  @keyframes bounce-in {
    0% {
      transform: scale(0);
    }
    50% {
      transform: scale(1.5);
    }
    100% {
      transform: scale(1);
    }
  }
</style>
