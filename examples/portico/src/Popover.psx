module Examples.Popover
  ( main
  ) where

import Prelude

import Effect (Effect)
import Portico ((:>))
import Portico as P
import Portico.Psx (Markup, root)

-- A menu, a dialog and a progress bar that need nothing from `update`: the
-- browser opens and closes the first two, and the third is styled from a
-- custom property.

view :: Unit -> Markup Unit
view _ =
  <main>
    <button id="menu-button" popovertarget="menu" aria-haspopup="menu">Menu</button>
    <div id="menu" popover="auto" data-kind="menu">
      <p>Light dismiss closes this.</p>
    </div>
    <button id="open-dialog" commandfor="dialog" command="show-modal">Open dialog</button>
    <dialog id="dialog">
      <p>A modal dialog.</p>
      <button id="close-dialog" commandfor="dialog" command="close">Close</button>
    </dialog>
    <div id="outside" inert><button>Unreachable</button></div>
    <div id="progress" style="--progress:0.4"></div>
  </main>

main :: Effect Unit
main = void $ P.mount "main"
  { init: unit :> []
  , update: \_ _ -> unit :> []
  , subscriptions: P.noSubscriptions
  , view: root <<< view
  }
