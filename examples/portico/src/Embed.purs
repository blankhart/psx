import Prelude

import Effect (Effect)
import Portico ((:>))
import Portico as P
import Portico.Psx (root)
import Portico.Psx as B
import Web.DOM (Element)
import Web.Event.Event (EventType(..))
import Web.HTML (window)
import Web.HTML.Window as Window
-- Two applications on one page, each with a subscription to the window. The
-- page around them talks to them through the `Handle` that `mount` returns.

type Model = Int

data Msg = Pressed | Bump

app :: String -> P.Application Model Msg
app name =
  { init: 0 :> []
  , update: \model -> case _ of
      Pressed -> (model + 1) :> []
      Bump -> (model + 10) :> []
  , subscriptions: \_ -> [ P.Subscription "keys" keys ]
  , view: \model -> root ([ B.div [ B.class_ "app" ] (B.children (name <> ": " <> show model)) ])
  }

keys :: P.Sub Msg
keys send = do
  target <- P.sync $ Window.toEventTarget <$> window
  P.onEvent (EventType "keydown") target (const Pressed) send

foreign import container :: String -> Effect Element
foreign import expose :: String -> Effect Unit -> Effect Unit

main :: Effect Unit
main = do
  one <- P.mount' <@> app "one" =<< container "one"
  two <- P.mount' <@> app "two" =<< container "two"
  expose "unmountOne" one.unmount
  expose "bumpTwo" (two.send Bump)
