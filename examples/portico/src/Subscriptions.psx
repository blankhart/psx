module Examples.Subscriptions where

import Prelude

import Control.Monad.Rec.Class (forever)
import Data.Array as Array
import Data.Tuple (Tuple(..))
import Effect (Effect)
import Effect.Aff (Milliseconds(..), delay)
import Effect.Class (liftEffect)
import Portico ((:>))
import Portico as P
import Portico.Psx (Markup, root)

type Model =
  { running :: Boolean
  , ticks :: Int
  , results :: Array String
  }

data Msg = Toggle | Tick | Search String | Found String

init :: P.Init Model Msg
init = { running: false, ticks: 0, results: [] } :> []

-- | Sends `msg` every `ms` milliseconds until it is stopped.
every :: forall msg. Number -> msg -> P.Sub msg
every ms msg = \send -> forever do
  delay (Milliseconds ms)
  liftEffect (send msg)

update :: P.Update Model Msg
update model = case _ of
  Toggle -> model { running = not model.running } :> []
  Tick -> model { ticks = model.ticks + 1 } :> []
  -- Each keystroke starts a slow search and stops the one before it, so only
  -- the last one ever answers.
  Search query ->
    Tuple model
      [ P.latest "search" \send -> do
          delay (Milliseconds 100.0)
          liftEffect (send (Found query))
      ]
  Found result -> model { results = Array.snoc model.results result } :> []

-- | The timer runs only while the model says so.
subscriptions :: P.Subscriptions Model Msg
subscriptions model = if model.running then [ P.Subscription "timer" (every 20.0 Tick) ] else []

view :: Model -> Markup Msg
view model =
  <main>
    <button id="toggle" onclick={Toggle}>{if model.running then "Stop" else "Start"}</button>
    <p id="ticks">{show model.ticks}</p>
    <input id="search" oninput={Search}>
    <ul id="results">{model.results <#> \result -> <li>{result}</li>}</ul>
  </main>

main :: Effect Unit
main = void $ P.mount "main" { init, update, subscriptions, view: root <<< view }
