-- Generated by psx from Form.psx
module Examples.Form where
import Prelude

import Data.String as String
import Effect (Effect)
import Portico ((:>))
import Portico as P
import Portico.Psx (Markup, root)
import Portico.Psx as B
type Model =
  { flavor :: String
  , open :: Boolean
  , editing :: Boolean
  , blurs :: Int
  , submitted :: String
  }

init :: P.Init Model Msg
init = { flavor: "vanilla", open: false, editing: true, blurs: 0, submitted: "" } :> []

data Msg
  = Flavor String
  | Open Boolean
  | Note String
  | Blurred
  | Submitted (Array P.FormField)

update :: P.Update Model Msg
update model = case _ of
  Flavor flavor -> model { flavor = flavor } :> []
  Open open -> model { open = open } :> []
  Note note -> model { editing = not (String.contains (String.Pattern "!") note) } :> []
  Blurred -> model { blurs = model.blurs + 1 } :> []
  Submitted fields ->
    model { submitted = String.joinWith "&" $ (\{ name, value } -> name <> "=" <> value) <$> fields } :> []

-- `P.onCheck` and `P.onSubmitWith` read the event, which no HTML attribute
-- says, so the checkbox and the form are Portico's own functions in holes.
view :: Model -> Markup Msg
view model =
  [ B.main [] ([
    B.select [ B.id "flavor", B.onInput (Flavor) ] ([
      B.option [ B.value "vanilla" ] ([ B.text "Vanilla" ]),
      B.option [ B.value "chocolate" ] ([ B.text "Chocolate" ]) ]
   ),
    B.p [ B.id "chosen" ] (B.children (model.flavor)),
    B.label [] (B.children (
       P.input [ P.id "open", P.type' "checkbox", P.checked model.open, P.onCheck Open ] []) <> [
      B.text "Open" ]
   ),

    B.div [ B.id "panel", B.class_ (if model.open then "open" else "") ] ([
      B.button [ B.disabled (not model.open) ] ([ B.text "Go" ]) ]
   ),


    B.div [ B.onFocusOut (Blurred) ] (B.children (
       if model.editing then [ B.input [ B.id "note", B.onInput (Note) ] [] ] else [])
   ),
    B.p [ B.id "blurs" ] (B.children (show model.blurs)) ] <> B.children (

     P.form [ P.id "order", P.onSubmitWith Submitted ]
      ( [
          B.input [ B.name "name", B.required true ] [],
          B.select [ B.name "size" ] ([
            B.option [ B.value "s" ] ([ B.text "Small" ]),
            B.option [ B.value "l" ] ([ B.text "Large" ]) ]
       ),
          B.button [ B.name "action", B.value "save" ] ([ B.text "Save" ]) ]

      )) <> [

    B.p [ B.id "submitted" ] (B.children (model.submitted)) ]
   ) ]

main :: Effect Unit
main = void $ P.mount "main" { init, update, subscriptions: P.noSubscriptions, view: root <<< view }
