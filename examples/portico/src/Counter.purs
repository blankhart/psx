-- Generated by psx from Counter.psx
module Examples.Counter where
import Prelude

import Effect (Effect)
import Portico ((:>))
import Portico as P
import Portico.Psx (Markup, root)
import Portico.Psx as B
type Model = Int

init :: Model
init = 0

data Msg = Increment | Decrement

update :: Model -> Msg -> Model
update model = case _ of
  Increment -> model + 1
  Decrement -> model - 1

view :: Model -> Markup Msg
view model =
  [ B.main [ B.id "main" ] ([
    B.button [ B.onClick (Decrement) ] ([ B.text "-" ]) ] <> B.children (
     show model) <> [
    B.button [ B.onClick (Increment) ] ([ B.text "+" ]) ]
   ) ]

main :: Effect Unit
main = do
  void $ P.mount "main"
    { init: init :> []
    , update: \model msg -> update model msg :> []
    , subscriptions: P.noSubscriptions
    , view: root <<< view
    }
