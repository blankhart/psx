module Examples.WebSocket where

import Prelude

import Control.Monad.Except (runExcept)
import Data.Array (snoc)
import Data.Either (hush)
import Data.Foldable (for_)
import Data.Maybe (Maybe(..), maybe)
import Data.Traversable (sequence)
import Data.Tuple (Tuple(..))
import Effect (Effect)
import Effect.Aff (effectCanceler, makeAff)
import Foreign (readString, unsafeToForeign)
import Portico ((:>))
import Portico as P
import Portico.Psx (Markup, root)
import Web.Event.EventTarget as EET
import Web.Socket.Event.EventTypes as WSET
import Web.Socket.Event.MessageEvent as ME
import Web.Socket.ReadyState (ReadyState)
import Web.Socket.WebSocket (WebSocket)
import Web.Socket.WebSocket as WS

url :: String
url = "wss://echo.websocket.org"

type Model =
  { connect :: Boolean
  , socket :: Maybe WebSocket
  , status :: Maybe ReadyState
  , chat :: String
  , log :: Array String
  }

data ChatMsg
  = UpdatedChat String
  | SubmittedChat
  | ReceivedChat String

data Msg
  = Connect Boolean
  | Opened WebSocket
  | ConnectionMsg ReadyState
  | ChatMsg ChatMsg

-- | The socket is open for as long as the model asks for it. When the key
-- | leaves `subscriptions`, the runtime kills the fiber and the canceler closes
-- | the socket.
socket :: P.Sub Msg
socket sink = makeAff \_ -> do
  ws <- WS.create url []
  let
    target = WS.toEventTarget ws
    status _ = sink <<< ConnectionMsg =<< WS.readyState ws
    message event = for_ (ME.fromEvent event) \msgEvent ->
      for_ (hush $ runExcept $ readString $ unsafeToForeign $ ME.data_ msgEvent)
        (sink <<< ChatMsg <<< ReceivedChat)
    listen eventType handler = do
      listener <- EET.eventListener handler
      EET.addEventListener eventType listener false target
      pure $ EET.removeEventListener eventType listener false target
  removers <- sequence
    [ listen WSET.onMessage message
    , listen WSET.onOpen status
    , listen WSET.onError status
    , listen WSET.onClose status
    ]
  sink (Opened ws)
  pure $ effectCanceler do
    for_ removers identity
    WS.close ws

init :: P.Init Model Msg
init = { connect: true, socket: Nothing, status: Nothing, chat: "Echo Me", log: [] } :> []

update :: P.Update Model Msg
update model = case _ of
  Connect connect ->
    model { connect = connect, socket = Nothing, status = Nothing } :> []
  Opened ws ->
    model { socket = Just ws } :> []
  ConnectionMsg status ->
    model { status = Just status } :> []
  ChatMsg msg -> case msg of
    ReceivedChat chat ->
      model { log = model.log `snoc` ("Echo: " <> chat <> "\n") } :> []
    UpdatedChat chat ->
      model { chat = chat } :> []
    SubmittedChat ->
      Tuple
        model { log = model.log `snoc` ("Sent: " <> model.chat <> "\n"), chat = "" }
        [ P.run $ for_ model.socket \ws -> WS.sendString ws model.chat ]

subscriptions :: P.Subscriptions Model Msg
subscriptions model = if model.connect then [ P.Subscription url socket ] else []

view :: Model -> Markup Msg
view model =
  <main>
    <div>
      Connection status: {maybe "Disconnected" show model.status}
      <br>
      <button id="connect" onclick={Connect (not model.connect)}>
        {if model.connect then "Disconnect" else "Connect"}
      </button>
      <br>
      <input value={model.chat} oninput={ChatMsg <<< UpdatedChat}>
      <button onclick={ChatMsg SubmittedChat}>Send</button>
    </div>
    <ul>{model.log <#> \line -> <li>{line}</li>}</ul>
  </main>

main :: Effect Unit
main = void $ P.mount "main" { init, update, subscriptions, view: root <<< view }
