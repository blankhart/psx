-- Generated by psx from Prompt.psx
module Examples.Prompt
  ( Model
  , Msg(..)
  , init
  , main
  , update
  , view
  ) where
import Prelude

import Data.Maybe (Maybe(..))
import Effect (Effect)
import Effect.Aff (Aff)
import Portico ((:>))
import Portico as P
import Portico.Psx (Markup, root)
import Portico.Psx as B
import Web.HTML as HTML
import Web.HTML.Window as Window
type Model = { name :: Maybe String }

prompt :: Aff Msg
prompt = do
  window <- P.sync HTML.window
  name <- P.sync $ Window.prompt "What's your name?" window
  pure $ Update name

init :: P.Init Model Msg
init = { name: Nothing } :> [ prompt ]

data Msg = Prompt | Update (Maybe String)

update :: P.Update Model Msg
update model = case _ of
  Prompt ->
    model :> [ prompt ]
  Update name ->
    model { name = name } :> []

view :: Model -> Markup Msg
view model =
  [ B.main [] ([
    B.button [ B.onClick (Prompt) ] ([ B.text "Hello" ]),
    B.div [] ([ B.text "Hello, " ] <> B.children (show model.name) <> [ B.text "!" ]) ]
   ) ]

main :: Effect Unit
main = void $ P.mount "main" { init, update, subscriptions: P.noSubscriptions, view: root <<< view }
