module Examples.Affjax where

import Prelude

import Affjax.ResponseFormat as ResponseFormat
import Affjax.Web as Affjax
import Data.Either (Either(..))
import Data.Tuple (Tuple(..))
import Effect (Effect)
import Effect.Class (liftEffect)
import Portico ((:>))
import Portico as P
import Portico.Psx (Markup, root)

type Model =
  { url :: String
  , result :: Result
  }

data Result = NotFetched | Fetching | Ok String | Error String

derive instance eqResult :: Eq Result

init :: P.Init Model Msg
init = Tuple
  { url: "https://httpbin.org/get"
  , result: NotFetched
  }
  [ P.focus "input" ]

data Msg = UpdateUrl String | Fetch | Fetched Result

update :: P.Update Model Msg
update model = case _ of
  UpdateUrl url ->
    model { url = url, result = NotFetched } :> []
  Fetch ->
    -- A second Fetch aborts the first request, so its reply cannot arrive
    -- after the second one's.
    Tuple model { result = Fetching }
      [ P.latest "fetch" \send -> do
          result <- Affjax.get ResponseFormat.string model.url
          liftEffect $ send $ Fetched case result of
            Left error -> Error $ Affjax.printError error
            Right response -> Ok response.body
      ]
  Fetched result ->
    model { result = result } :> []

view :: Model -> Markup Msg
view model =
  <main id="main">
    <input oninput={UpdateUrl} value={model.url}>
    <button onclick={Fetch} disabled={model.result == Fetching}>Fetch</button>
    {case model.result of
      NotFetched ->
        <div>Not Fetched...</div>
      Fetching ->
        <div>Fetching...</div>
      Ok ok ->
        <pre><code>Ok: {ok}</code></pre>
      Error error ->
        <div>Error: {error}</div>
    }
  </main>

main :: Effect Unit
main = do
  void $ P.mount "main" { init, update, subscriptions: P.noSubscriptions, view: root <<< view }
