module Examples.Form where

import Prelude

import Data.String as String
import Effect (Effect)
import Portico ((:>))
import Portico as P
import Portico.Psx (Markup, root)

type Model =
  { flavor :: String
  , open :: Boolean
  , editing :: Boolean
  , blurs :: Int
  , submitted :: String
  }

init :: P.Init Model Msg
init = { flavor: "vanilla", open: false, editing: true, blurs: 0, submitted: "" } :> []

data Msg
  = Flavor String
  | Open Boolean
  | Note String
  | Blurred
  | Submitted (Array P.FormField)

update :: P.Update Model Msg
update model = case _ of
  Flavor flavor -> model { flavor = flavor } :> []
  Open open -> model { open = open } :> []
  Note note -> model { editing = not (String.contains (String.Pattern "!") note) } :> []
  Blurred -> model { blurs = model.blurs + 1 } :> []
  Submitted fields ->
    model { submitted = String.joinWith "&" $ (\{ name, value } -> name <> "=" <> value) <$> fields } :> []

-- `P.onCheck` and `P.onSubmitWith` read the event, which no HTML attribute
-- says, so they are trait holes.
view :: Model -> Markup Msg
view model =
  <main>
    <select id="flavor" oninput={Flavor}>
      <option value="vanilla">Vanilla</option>
      <option value="chocolate">Chocolate</option>
    </select>
    <p id="chosen">{model.flavor}</p>
    <label>
      <input id="open" type="checkbox" checked={model.open} {P.onCheck Open}>
      Open
    </label>
    <!-- An attribute whose value changes is updated, and one that goes is unset. -->
    <div id="panel" class={if model.open then "open" else ""}>
      <button disabled={not model.open}>Go</button>
    </div>
    <!-- Typing "!" removes the input while it has focus, so the browser fires
         `focusout` on the div in the middle of the patch that removes the input. -->
    <div onfocusout={Blurred}>
      {if model.editing then <input id="note" oninput={Note}> else <></>}
    </div>
    <p id="blurs">{show model.blurs}</p>
    <!-- The browser validates the form before anything is sent. -->
    <form id="order" {P.onSubmitWith Submitted}>
      <input name="name" required>
      <select name="size">
        <option value="s">Small</option>
        <option value="l">Large</option>
      </select>
      <button name="action" value="save">Save</button>
    </form>
    <p id="submitted">{model.submitted}</p>
  </main>

main :: Effect Unit
main = void $ P.mount "main" { init, update, subscriptions: P.noSubscriptions, view: root <<< view }
