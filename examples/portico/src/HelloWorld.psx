module Examples.HelloWorld where

import Prelude

import Effect (Effect)
import Portico ((:>))
import Portico as P
import Portico.Psx (root)

main :: Effect Unit
main = do
  let
    html = root
      ( <main>
          Hello, world!
        </main>
      )
    app =
      { init: unit :> []
      , update: \_ _ -> unit :> []
      , subscriptions: P.noSubscriptions
      , view: const html
      }
  void $ P.mount "main" app
