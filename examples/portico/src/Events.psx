module Examples.Events where

import Prelude

import Data.Array as Array
import Data.Maybe (Maybe(..))
import Data.String as String
import Effect (Effect)
import Portico ((:>))
import Portico as P
import Portico.Psx (Markup, root)
import Web.Event.Event as Event

type Model =
  { draft :: String
  , items :: Array String
  , x :: Int
  , y :: Int
  , clicks :: Array String
  }

data Direction = Up | Down | Left | Right

data Msg
  = Draft String
  | Add
  | Discard
  | Move Direction
  | Clicked String

init :: P.Init Model Msg
init = { draft: "", items: [], x: 0, y: 0, clicks: [] } :> []

update :: P.Update Model Msg
update model = case _ of
  Draft draft -> model { draft = draft } :> []
  Add -> model { items = Array.snoc model.items model.draft, draft = "" } :> []
  Discard -> model { draft = "" } :> []
  Move Up -> model { y = model.y - 1 } :> []
  Move Down -> model { y = model.y + 1 } :> []
  Move Left -> model { x = model.x - 1 } :> []
  Move Right -> model { x = model.x + 1 } :> []
  Clicked name -> model { clicks = Array.snoc model.clicks name } :> []

-- | A handler with its own message type, retagged with `map` where it is used.
arrowKey :: String -> Maybe Direction
arrowKey = case _ of
  "ArrowUp" -> Just Up
  "ArrowDown" -> Just Down
  "ArrowLeft" -> Just Left
  "ArrowRight" -> Just Right
  _ -> Nothing

-- Listener options and handlers that read the event are Portico's own
-- functions, so they are trait holes.
view :: Model -> Markup Msg
view model =
  <main>
    <!-- Enter adds, Escape discards, and every other key sends nothing. -->
    <input
      id="draft"
      value={model.draft}
      oninput={Draft}
      onkeydown={case _ of
        "Enter" -> Just Add
        "Escape" -> Just Discard
        _ -> Nothing}
    >
    <ul id="items">{model.items <#> \item -> <li>{item}</li>}</ul>
    <div id="pad" tabindex="0" onkeydown={map Move <<< arrowKey}>
      {show model.x <> "," <> show model.y}
    </div>
    <!-- A capturing listener on the outside hears the click first. -->
    <div id="outer" {P.onWith "click" { capture: true, passive: false } \_ -> pure (Just (Clicked "outer"))}>
      <button id="inner" onclick={Clicked "inner"}>Inner</button>
    </div>
    <!-- A passive listener cannot cancel the event, so this link is followed. -->
    <a
      id="passive"
      href="#passive"
      {P.onWith "click" { capture: false, passive: true } \event -> do
        Event.preventDefault event
        pure (Just (Clicked "passive"))}
    >
      Passive
    </a>
    <a
      id="active"
      href="#active"
      {P.onMaybe "click" \event -> do
        Event.preventDefault event
        pure (Just (Clicked "active"))}
    >
      Active
    </a>
    <p id="clicks">{String.joinWith " " model.clicks}</p>
  </main>

main :: Effect Unit
main = void $ P.mount "main" { init, update, subscriptions: P.noSubscriptions, view: root <<< view }
