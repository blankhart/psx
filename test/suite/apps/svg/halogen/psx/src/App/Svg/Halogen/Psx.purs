-- Generated by psx from Psx.psx
-- | The svg scenario on Halogen, in PSX.
module App.Svg.Halogen.Psx (main) where
import Prelude

import Data.Array as Array
import Data.Foldable (for_)
import Data.Maybe (Maybe(..), fromMaybe)
import Data.String as String
import Effect (Effect)
import Effect.Class (liftEffect)
import Halogen as H
import Halogen.Aff as HA
import Halogen.VDom.Driver (runUI)
import Web.DOM.Node (removeChild)
import Web.DOM.ParentNode (QuerySelector(..))
import Web.HTML.HTMLElement (toNode)
import Halogen.Psx (Markup, root)
import Halogen.Psx as B
type Fixture = { values :: Array Int, max :: Int }

type State = { values :: Array Int, max :: Int, selected :: Maybe Int }

data Action = Select Int | Grow

update :: State -> Action -> State
update state = case _ of
  Select i -> state { selected = Just i }
  Grow -> case state.selected of
    Just i -> state { values = fromMaybe state.values (Array.modifyAt i (\v -> min state.max (v + 1)) state.values) }
    Nothing -> state

-- | A bar's left edge and top, in the chart's coordinates.
left :: Int -> Int
left i = 10 + 20 * i

barTop :: Int -> Int
barTop v = 55 - 4 * v

-- | The line through the tops of the bars.
trend :: Array Int -> String
trend values = String.joinWith " " (Array.mapWithIndex point values)
  where
  point i v = (if i == 0 then "M " else "L ") <> show (left i + 8) <> " " <> show (barTop v)

view :: forall w. State -> Markup w Action
view state =
  [ B.figure [ B.class_ "chart", B.attribute "data-testid" "chart" ] ([
    B.svg [ B.viewBox "0 0 120 60", B.width "360", B.height "180" ] ([
      B.g [ B.class_ "bars" ] (B.children (

          Array.mapWithIndex
            ( \i v ->
                [ B.keyed (i) (B.rect [ B.attribute "data-testid" ("bar-" <> show i), B.x (show (left i)), B.y (show (barTop v)), B.width "16", B.height (show (4 * v)), B.fill (if state.selected == Just i then "orange" else "steelblue"), B.onClick (Select i) ] B.none) ]
            )
            state.values)

   ),
      B.path [ B.class_ "trend", B.d (trend state.values), B.fill "none", B.stroke "gray" ] B.none,
      B.line [ B.x1 "5", B.y1 "55", B.x2 "115", B.y2 "55", B.stroke "black" ] B.none ] <> B.children (

        case state.selected of
          Just i -> [ B.circle [ B.cx (show (left i + 8)), B.cy (show (barTop (value i))), B.r "2", B.fill "orange" ] B.none ]
          Nothing -> []) <> [

      B.textEl [ B.x "5", B.y "8" ] ([ B.text "Values" ]) ]
   ),
    B.figcaption [ B.attribute "data-testid" "caption" ] (B.children (

        case state.selected of
          Just i -> "Bar " <> show i <> ": " <> show (value i)
          Nothing -> "Click a bar")

   ),
    B.button [ B.attribute "data-testid" "grow", B.onClick (Grow), B.disabled (state.selected == Nothing) ] ([ B.text "Grow" ]) ]
   ) ]
  where
  value i = fromMaybe 0 (Array.index state.values i)

component :: forall q o m. Fixture -> H.Component q Unit o m
component fixture = H.mkComponent
  { initialState: const { values: fixture.values, max: fixture.max, selected: Nothing }
  , render: root <<< view
  , eval: H.mkEval H.defaultEval { handleAction = \action -> H.modify_ (\state -> update state action) }
  }

-- | Mounts in place of `#app`, with the scenario's fixture.
main :: Fixture -> Effect Unit
main fixture = HA.runHalogenAff do
  app <- HA.selectElement (QuerySelector "#app")
  parent <- HA.selectElement (QuerySelector "#root")
  for_ parent \p -> do
    for_ app \a -> liftEffect (removeChild (toNode a) (toNode p))
    runUI (component fixture) unit p
