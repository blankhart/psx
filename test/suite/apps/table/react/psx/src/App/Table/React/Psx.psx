-- | The table scenario on React, in PSX.
module App.Table.React.Psx (main) where

import Prelude

import Data.Array as Array
import Data.Maybe (Maybe(..))
import Effect (Effect)
import Suite.React as React
import React.Basic.Hooks.Psx (Markup, root)
import Suite.Shared.Table (Source, TableRow)
import Suite.Shared.Table as Table

type Model = { rows :: Array TableRow, selected :: Maybe Int, source :: Source }

data Msg = Create Int | Append Int | Update | Clear | Swap | Select Int | Remove Int

update :: Model -> Msg -> Model
update model = case _ of
  Create n -> let made = Table.rows n model.source in model { rows = made.rows, source = made.source }
  Append n -> let made = Table.rows n model.source in model { rows = model.rows <> made.rows, source = made.source }
  Update -> model { rows = Table.updateEvery model.rows }
  Clear -> model { rows = [] }
  Swap -> model { rows = Table.swap model.rows }
  Select id -> model { selected = Just id }
  Remove id -> model { rows = Array.filter (\row -> row.id /= id) model.rows }

buttons :: Array { id :: String, text :: String, msg :: Msg }
buttons =
  [ { id: "run", text: "Create 1,000 rows", msg: Create 1000 }
  , { id: "runlots", text: "Create 10,000 rows", msg: Create 10000 }
  , { id: "add", text: "Append 1,000 rows", msg: Append 1000 }
  , { id: "update", text: "Update every 10th row", msg: Update }
  , { id: "clear", text: "Clear", msg: Clear }
  , { id: "swaprows", text: "Swap Rows", msg: Swap }
  ]

view :: (Msg -> Effect Unit) -> Model -> Markup (Effect Unit)
view dispatch model =
  <div class="container" data-testid="table">
    <div class="jumbotron">
      <div class="row">
        <div class="col-md-6"><h1>PSX table</h1></div>
        <div class="col-md-6">
          {
            map
              ( \b ->
                  <div class="col-sm-6 smallpad">
                    <button type="button" class="btn btn-primary btn-block" id={b.id} data-testid={b.id} onclick={dispatch (b.msg)}>{b.text}</button>
                  </div>
              )
              buttons
          }
        </div>
      </div>
    </div>
    <table class="table table-hover table-striped test-data">
      <tbody>
        {
          map
            ( \row ->
                <tr key={row.id} class={if model.selected == Just row.id then "danger" else "row"}>
                  <td class="col-md-1">{show row.id}</td>
                  <td class="col-md-4"><a data-testid={"select-" <> show row.id} onclick={dispatch (Select row.id)}>{row.label}</a></td>
                  <td class="col-md-1">
                    <a data-testid={"remove-" <> show row.id} onclick={dispatch (Remove row.id)}><span class="glyphicon glyphicon-remove" aria-hidden="true"></span></a>
                  </td>
                  <td class="col-md-6"></td>
                </tr>
            )
            model.rows
        }
      </tbody>
    </table>
    <span class="preloadicon glyphicon glyphicon-remove" aria-hidden="true"></span>
  </div>

main :: { seed :: Number } -> Effect Unit
main fixture = React.mount ({ rows: [], selected: Nothing, source: Table.source fixture.seed }) update (\dispatch model -> root (view dispatch model))
