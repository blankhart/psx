-- Generated by psx from Counter.psx
-- | The child: a counter component with its own state, which tells its
-- | parent its count after each change.
module App.Nested.Halogen.Psx.Counter
  ( Input
  , Output
  , counter
  ) where
import Prelude

import Halogen as H
import Halogen.Psx (Markup, root)
import Halogen.Psx as B
type Input = { id :: Int, label :: String, start :: Int }

type State = { id :: Int, label :: String, count :: Int }

data Action = Increment | Decrement

-- | Its count, after each change.
type Output = Int

handle :: forall m. Action -> H.HalogenM State Action () Output m Unit
handle action = do
  state <- H.modify \s -> s { count = s.count + (if action == Increment then 1 else -1) }
  H.raise state.count

derive instance Eq Action

view :: forall w. State -> Markup w Action
view state =
  [ B.div [ B.class_ "counter", B.attribute "data-testid" ("counter-" <> show state.id) ] ([
    B.span [ B.class_ "count" ] (B.children (state.label) <> [ B.text ": " ] <> B.children (show state.count)),
    B.button [ B.attribute "data-testid" ("decrement-" <> show state.id), B.onClick (Decrement) ] ([ B.text "-" ]),
    B.button [ B.attribute "data-testid" ("increment-" <> show state.id), B.onClick (Increment) ] ([ B.text "+" ]) ]
   ) ]

counter :: forall q m. H.Component q Input Output m
counter = H.mkComponent
  { initialState: \i -> { id: i.id, label: i.label, count: i.start }
  , render: root <<< view
  , eval: H.mkEval H.defaultEval { handleAction = handle }
  }
