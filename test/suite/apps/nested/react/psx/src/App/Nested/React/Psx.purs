module App.Nested.React.Psx (main) where
import Prelude

import Data.Array as Array
import Data.Foldable (foldl, sum)
import Effect (Effect)
import Suite.React as React
import React.Basic.Hooks.Psx (Markup, root)
import React.Basic.Hooks.Psx as B
import App.Nested.React.Psx.Counter as Counter
type Child = { id :: Int, label :: String, count :: Counter.Model }

type Fixture = { counters :: Array { id :: Int, label :: String, start :: Int } }

type Model = { children :: Array Child, next :: Int }

data Msg = Add | Remove Int | Child Int Counter.Msg

init :: Fixture -> Model
init fixture =
  { children: map (\c -> { id: c.id, label: c.label, count: c.start }) fixture.counters
  , next: 1 + foldl (\n c -> max n c.id) 0 fixture.counters
  }

update :: Model -> Msg -> Model
update model = case _ of
  Add ->
    model
      { children = Array.snoc model.children { id: model.next, label: "Counter " <> show model.next, count: 0 }
      , next = model.next + 1
      }
  Remove id -> model { children = Array.filter (\c -> c.id /= id) model.children }
  Child id msg -> model { children = map (\c -> if c.id == id then c { count = Counter.update c.count msg } else c) model.children }

view :: (Msg -> Effect Unit) -> Model -> Markup (Effect Unit)
view dispatch model =
  [ B.section [ B.class_ "nested", B.attribute "data-testid" "nested" ] ([
    B.p [ B.attribute "data-testid" "total" ] ([ B.text "Total: " ] <> B.children (show (sum (map _.count model.children)))),
    B.ul [ B.class_ "counters" ] (B.children (

        map
          ( \c ->
              [ B.keyed (c.id) (B.li [ B.class_ "child" ] (B.children (
                 Counter.view (dispatch <<< Child c.id) c.id c.label c.count) <> [
                B.button [ B.attribute "data-testid" ("remove-" <> show c.id), B.onClick (dispatch (Remove c.id)) ] ([ B.text "Remove" ]) ]
               )) ]
          )
          model.children)

   ),
    B.button [ B.attribute "data-testid" "add", B.onClick (dispatch (Add)) ] ([ B.text "Add a counter" ]) ]
   ) ]

main :: Fixture -> Effect Unit
main fixture = React.mount (init fixture) update (\dispatch model -> root (view dispatch model))
