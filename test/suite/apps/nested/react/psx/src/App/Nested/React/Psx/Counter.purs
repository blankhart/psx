-- Generated by psx from Counter.psx
-- | The child: a counter with its own model, messages and view, which the
-- | parent composes.
module App.Nested.React.Psx.Counter
  ( Model
  , Msg
  , update
  , view
  ) where
import Prelude
import Effect (Effect)

import React.Basic.Hooks.Psx (Markup)
import React.Basic.Hooks.Psx as B
type Model = Int

data Msg = Increment | Decrement

update :: Model -> Msg -> Model
update n = case _ of
  Increment -> n + 1
  Decrement -> n - 1

view :: (Msg -> Effect Unit) -> Int -> String -> Model -> Markup (Effect Unit)
view dispatch id label n =
  [ B.div [ B.class_ "counter", B.attribute "data-testid" ("counter-" <> show id) ] ([
    B.span [ B.class_ "count" ] (B.children (label) <> [ B.text ": " ] <> B.children (show n)),
    B.button [ B.attribute "data-testid" ("decrement-" <> show id), B.onClick (dispatch (Decrement)) ] ([ B.text "-" ]),
    B.button [ B.attribute "data-testid" ("increment-" <> show id), B.onClick (dispatch (Increment)) ] ([ B.text "+" ]) ]
   ) ]
