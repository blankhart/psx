-- | The todo scenario on React, in PSX.
module App.Todo.React.Psx (main) where

import Prelude

import Data.Array as Array
import Data.Foldable (foldl)
import Effect (Effect)
import Suite.React as React
import React.Basic.Hooks.Psx (Markup, root)

type Todo = { id :: Int, text :: String, done :: Boolean }

type Fixture = { todos :: Array Todo }

data Filter = All | Active | Completed

derive instance Eq Filter

type Model = { todos :: Array Todo, draft :: String, filter :: Filter, next :: Int }

data Msg = Draft String | Add | Toggle Int | Remove Int | Show Filter

init :: Fixture -> Model
init fixture =
  { todos: fixture.todos
  , draft: ""
  , filter: All
  , next: 1 + foldl (\n todo -> max n todo.id) 0 fixture.todos
  }

update :: Model -> Msg -> Model
update model = case _ of
  Draft draft -> model { draft = draft }
  Add ->
    model
      { todos = Array.snoc model.todos { id: model.next, text: model.draft, done: false }
      , draft = ""
      , next = model.next + 1
      }
  Toggle id -> model { todos = map (\todo -> if todo.id == id then todo { done = not todo.done } else todo) model.todos }
  Remove id -> model { todos = Array.filter (\todo -> todo.id /= id) model.todos }
  Show filter -> model { filter = filter }

shown :: Filter -> Todo -> Boolean
shown filter todo = case filter of
  All -> true
  Active -> not todo.done
  Completed -> todo.done

view :: (Msg -> Effect Unit) -> Model -> Markup (Effect Unit)
view dispatch model =
  <section class="todo" data-testid="todo">
    <h1>Todos</h1>
    <div class="new">
      <input type="text" data-testid="draft" value={model.draft} oninput={dispatch <<< Draft}>
      <button data-testid="add" onclick={dispatch (Add)} disabled={model.draft == ""}>Add</button>
    </div>
    <ul class="items">
      {
        map
          ( \todo ->
              <li key={todo.id} class={if todo.done then "item done" else "item"}>
                <input type="checkbox" data-testid={"toggle-" <> show todo.id} checked={todo.done} onchange={dispatch (Toggle todo.id)}>
                <span>{todo.text}</span>
                <button data-testid={"remove-" <> show todo.id} onclick={dispatch (Remove todo.id)}>Remove</button>
              </li>
          )
          (Array.filter (shown model.filter) model.todos)
      }
    </ul>
    <p data-testid="left">{show (Array.length (Array.filter (not <<< _.done) model.todos))} left</p>
    <div class="filters">
      <button data-testid="all" onclick={dispatch (Show All)} disabled={model.filter == All}>All</button>
      <button data-testid="active" onclick={dispatch (Show Active)} disabled={model.filter == Active}>Active</button>
      <button data-testid="completed" onclick={dispatch (Show Completed)} disabled={model.filter == Completed}>Completed</button>
    </div>
  </section>

main :: Fixture -> Effect Unit
main fixture = React.mount (init fixture) update (\dispatch model -> root (view dispatch model))
