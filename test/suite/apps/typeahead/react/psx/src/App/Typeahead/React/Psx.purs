-- Generated by psx from Psx.psx
-- | The typeahead scenario on React, in PSX. Each query runs as a command
-- | under `P.latest`, so a newer query stops the one still waiting.
module App.Typeahead.React.Psx (main) where
import Prelude

import Data.Array as Array
import Data.Maybe (Maybe(..), fromMaybe)
import Data.String as String
import Data.Time.Duration (Milliseconds(..))
import Effect (Effect)
import Suite.React as React
import Effect.Aff (delay, launchAff)
import Effect.Class (liftEffect)
import React.Basic.Hooks.Psx (Markup, root)
import React.Basic.Hooks.Psx as B
import Suite.Shared.Typeahead (Fixture, search)
type Model =
  { query :: String
  -- | The query the results answer.
  , answered :: String
  , results :: Array String
  , selected :: Int
  , chosen :: String
  }

data Msg = Query String | Answer String (Array String) | Move Int | Choose

init :: Model
init = { query: "", answered: "", results: [], selected: 0, chosen: "" }

update :: Fixture -> ((Model -> Model) -> Effect Unit) -> Model -> Msg -> Effect Unit
update fixture set _ = case _ of
  Query query -> do
    set (_ { query = query })
    if String.length query < 3 then
      set (_ { answered = query, results = [] })
    else void $ launchAff do
      delay (Milliseconds fixture.debounce)
      results <- search fixture query
      liftEffect $ set \current ->
        if current.query == query then current { answered = query, results = results, selected = 0 }
        else current
  Answer query results -> set \current ->
    if current.query == query then current { answered = query, results = results, selected = 0 } else current
  Move by -> set (\current -> current { selected = clamp 0 (Array.length current.results - 1) (current.selected + by) })
  Choose -> set (\current -> current { chosen = fromMaybe current.chosen (Array.index current.results current.selected) })

key :: String -> Maybe Msg
key = case _ of
  "ArrowDown" -> Just (Move 1)
  "ArrowUp" -> Just (Move (-1))
  "Enter" -> Just Choose
  _ -> Nothing

status :: Model -> String
status model
  | String.length model.query < 3 = "Type at least three letters"
  | model.answered /= model.query = "Searching…"
  | Array.length model.results == 1 = "1 result"
  | otherwise = show (Array.length model.results) <> " results"

view :: (Msg -> Effect Unit) -> Model -> Markup (Effect Unit)
view dispatch model =
  [ B.div [ B.class_ "typeahead", B.attribute "data-testid" "typeahead" ] ([
    B.input [ B.type' "text", B.attribute "data-testid" "search", B.placeholder "Search fruit", B.onInput (dispatch <<< Query), B.onKeyDown (map dispatch <<< key) ] B.none,
    B.p [ B.attribute "data-testid" "status" ] (B.children (status model)),
    B.ul [ B.class_ "results" ] (B.children (

        Array.mapWithIndex
          ( \i name ->
              [ B.keyed (name) (B.li [ B.attribute "data-testid" ("result-" <> show i), B.class_ (if i == model.selected then "result selected" else "result") ] (B.children (name))) ]
          )
          model.results)

   ),
    B.p [ B.attribute "data-testid" "chosen" ] (B.children (if model.chosen == "" then "" else "Chosen: " <> model.chosen)) ]
   ) ]

main :: Fixture -> Effect Unit
main fixture = React.mountWith init (update fixture) (\dispatch model -> root (view dispatch model))
