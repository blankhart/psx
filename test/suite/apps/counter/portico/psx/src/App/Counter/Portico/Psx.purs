-- Generated by psx from Psx.psx
-- | The counter scenario on Portico, in PSX: `App.Counter` from the design
-- | doc, with its scoped `<style>`.
module App.Counter.Portico.Psx (main) where
import Prelude
import Data.Array ((..))
import Effect (Effect)
import Portico ((:>))
import Portico as P
import Portico.Psx (Markup, root)
import Portico.Psx as B
import App.Counter.Portico.Psx.PsxStyle as B.Style
type Props = { label :: String, max :: Int }

data Msg = Increment | Decrement | Reset

update :: Int -> Msg -> Int
update n = case _ of
  Increment -> n + 1
  Decrement -> n - 1
  Reset -> 0

view :: Props -> Int -> Markup Msg
view props n =
  [ B.section [ B.class_ "counter", B.attribute "data-testid" "counter", B.attribute "data-psx" B.Style.scope ] ([
    B.h2 [ B.attribute "data-testid" "label" ] (B.children (props.label) <> [ B.text ": " ] <> B.children (show n)),
    B.button [ B.attribute "data-testid" "decrement", B.onClick (Decrement), B.disabled (n <= 0) ] ([ B.text "-" ]),
    B.button [ B.attribute "data-testid" "increment", B.onClick (Increment), B.disabled (n >= props.max) ] ([ B.text "+" ]) ] <> B.children (

      if n == 0 then
        []
      else
        [ B.button [ B.attribute "data-testid" "reset", B.onClick (Reset) ] ([ B.text "Reset" ]) ]) <> [

    B.ol [ B.class_ "pips" ] (B.children (

        map
          (\i -> [ B.keyed (i) (B.li [ B.class_ (if i <= n then "pip filled" else "pip") ] B.none) ])
          (1 .. props.max))

   ) ]





   ) ]

-- | Mounts on `#app`, with the scenario's fixture as the props.
main :: Props -> Effect Unit
main props =
  void $ P.mount "#app"
    { init: 0 :> []
    , update: \n msg -> update n msg :> []
    , subscriptions: P.noSubscriptions
    , view: root <<< view props
    }
