import Prelude
import Data.Array ((..))
import Effect (Effect)
import Suite.React as React
import React.Basic.Hooks.Psx (Markup, root)
import React.Basic.Hooks.Psx as B
import App.Counter.React.Psx.PsxStyle as B.Style
type Props = { label :: String, max :: Int }

data Msg = Increment | Decrement | Reset

update :: Int -> Msg -> Int
update n = case _ of
  Increment -> n + 1
  Decrement -> n - 1
  Reset -> 0

view :: (Msg -> Effect Unit) -> Props -> Int -> Markup (Effect Unit)
view dispatch props n =
  [ B.section [ B.class_ "counter", B.attribute "data-testid" "counter", B.attribute "data-psx" B.Style.scope ] ([
    B.h2 [ B.attribute "data-testid" "label" ] (B.children (props.label) <> [ B.text ": " ] <> B.children (show n)),
    B.button [ B.attribute "data-testid" "decrement", B.onClick (dispatch (Decrement)), B.disabled (n <= 0) ] ([ B.text "-" ]),
    B.button [ B.attribute "data-testid" "increment", B.onClick (dispatch (Increment)), B.disabled (n >= props.max) ] ([ B.text "+" ]) ] <> B.children (

      if n == 0 then
        []
      else
        [ B.button [ B.attribute "data-testid" "reset", B.onClick (dispatch (Reset)) ] ([ B.text "Reset" ]) ]) <> [

    B.ol [ B.class_ "pips" ] (B.children (

        map
          (\i -> [ B.keyed (i) (B.li [ B.class_ (if i <= n then "pip filled" else "pip") ] B.none) ])
          (1 .. props.max))

   ) ]





   ) ]

main :: Props -> Effect Unit
main fixture = React.mount (0) update (\dispatch model -> root (view dispatch fixture model))
