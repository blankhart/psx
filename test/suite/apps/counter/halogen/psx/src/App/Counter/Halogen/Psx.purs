-- Generated by psx from Psx.psx
-- | The counter scenario on Halogen, in PSX: `App.Counter` from the design
-- | doc, with its scoped `<style>`.
module App.Counter.Halogen.Psx (main) where
import Prelude
import Data.Array ((..))
import Data.Foldable (for_)
import Effect (Effect)
import Effect.Class (liftEffect)
import Halogen as H
import Halogen.Aff as HA
import Halogen.Psx (Markup, root)
import Halogen.Psx as B
import App.Counter.Halogen.Psx.PsxStyle as B.Style
import Halogen.VDom.Driver (runUI)
import Web.DOM.Node (removeChild)
import Web.DOM.ParentNode (QuerySelector(..))
import Web.HTML.HTMLElement (toNode)
type Props = { label :: String, max :: Int }

data Msg = Increment | Decrement | Reset

update :: Int -> Msg -> Int
update n = case _ of
  Increment -> n + 1
  Decrement -> n - 1
  Reset -> 0

view :: forall w. Props -> Int -> Markup w Msg
view props n =
  [ B.section [ B.class_ "counter", B.attribute "data-testid" "counter", B.attribute "data-psx" B.Style.scope ] ([
    B.h2 [ B.attribute "data-testid" "label" ] (B.children (props.label) <> [ B.text ": " ] <> B.children (show n)),
    B.button [ B.attribute "data-testid" "decrement", B.onClick (Decrement), B.disabled (n <= 0) ] ([ B.text "-" ]),
    B.button [ B.attribute "data-testid" "increment", B.onClick (Increment), B.disabled (n >= props.max) ] ([ B.text "+" ]) ] <> B.children (

      if n == 0 then
        []
      else
        [ B.button [ B.attribute "data-testid" "reset", B.onClick (Reset) ] ([ B.text "Reset" ]) ]) <> [

    B.keyedElement "ol" [ B.class_ "pips" ] (B.keyedChildren (

        map
          (\i -> [ B.keyed (i) (B.li [ B.class_ (if i <= n then "pip filled" else "pip") ] []) ])
          (1 .. props.max))

   ) ]





   ) ]

component :: forall q o m. Props -> H.Component q Unit o m
component props = H.mkComponent
  { initialState: const 0
  , render: root <<< view props
  , eval: H.mkEval H.defaultEval { handleAction = \msg -> H.modify_ (\n -> update n msg) }
  }

-- | Mounts in place of `#app`, with the scenario's fixture as the props.
main :: Props -> Effect Unit
main props = HA.runHalogenAff do
  app <- HA.selectElement (QuerySelector "#app")
  parent <- HA.selectElement (QuerySelector "#root")
  for_ parent \p -> do
    for_ app \a -> liftEffect (removeChild (toNode a) (toNode p))
    runUI (component props) unit p
