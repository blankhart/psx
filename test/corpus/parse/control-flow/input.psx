module Parse.ControlFlow where

import Portico.Psx

view n items =
  <div>
    {
      if n == 0 then
        <></>
      else
        <button onclick={Reset}>Reset</button>
    }
    {case items of
      [] -> <p>No items</p>
      _ -> <ul>{map (\i -> <li key={i}>{i}</li>) items}</ul>}
    {
      map
        (\i -> <li key={i} class={if i <= n then "pip filled" else "pip"}></li>)
        (1 .. n)
    }
  </div>

withDo = <div>{do
  let x = 1
  show x}</div>

withLet = <p>{let y = 2 in show y}</p>
