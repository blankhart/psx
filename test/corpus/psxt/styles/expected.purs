-- Generated by psx from input.psxt
module App.Card where
import Prelude
import Portico.Psx (Markup)
import Portico.Psx as B
import App.Card.PsxStyle as B.Style



card :: String -> Markup Unit
card title =
  [ B.article [ B.class_ "card", B.attribute "data-psx" B.Style.scope ] ([
    B.h2 [] (B.children (title)) ] <> B.children (
     badge 3) <> [
    B.aside [ B.class_ "note", B.attribute "data-psx" B.Style.scope2 ] ([
      B.text "Aside" ]



 ) ]
 ) ]

badge :: Int -> Markup Unit
badge n =
  [ B.span [ B.class_ "badge", B.attribute "data-psx" B.Style.scope ] (B.children (show n)) ]




















