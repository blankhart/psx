<!-- A template's name and arguments are the head of its equation, in
     `head`; `name` and `args` are not attributes of a template. -->
<script type="text/purescript">
module App.Args where

import Prelude
import Portico.Psx (Markup)

foreign import view :: Int -> Markup Unit
foreign import card :: Int -> Markup Unit
</script>
<template name="view n"><p>{show n}</p></template>
<template head="card" args="n"><p>{show n}</p></template>
