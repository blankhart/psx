-- Generated by psx from input.psxt


module App.Status where

import Prelude
import Data.Maybe (Maybe(..))
import Data.Tuple (Tuple(..))
import Portico.Psx (Markup)
import Portico.Psx as B
data Status = Loading | Failed String | Loaded (Array String)





status :: Status -> Markup Unit
status Loading =
  [ B.p [] ([ B.text "Loading…" ]) ]

status (Failed reason) =
  [ B.p [ B.class_ "error" ] (B.children (reason)) ]

status (Loaded items) =
  [ B.ul [] (B.children (map (\item -> [ B.li [] (B.children (item)) ]) items)) ]

pair :: Tuple String (Maybe Int) -> Markup Unit
pair (Tuple label (Just n)) =
  [ B.p [] (B.children (label) <> [ B.text ": " ] <> B.children (show n)) ]

pair (Tuple label Nothing) =
  [ B.p [] (B.children (label)) ]

badge :: Int -> Markup Unit
badge n | n > 99 =
  [ B.span [ B.class_ "badge" ] ([ B.text "99+" ]) ]

badge n | n > 0, n < 10 =
  [ B.span [ B.class_ "badge" ] (B.children (show n)) ]

badge _ =
  [ B.span [ B.class_ "badge" ] (B.children ("many")) ]

