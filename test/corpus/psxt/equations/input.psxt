<!-- Templates with one name are the equations of one function, one per
     pattern or guard, and lower to its equations in order. -->
<script type="text/purescript">
module App.Status where

import Prelude
import Data.Maybe (Maybe(..))
import Data.Tuple (Tuple(..))
import Portico.Psx (Markup)

data Status = Loading | Failed String | Loaded (Array String)

foreign import status :: Status -> Markup Unit
foreign import pair :: Tuple String (Maybe Int) -> Markup Unit
foreign import badge :: Int -> Markup Unit
</script>

<template head="status Loading">
  <p>Loading…</p>
</template>
<template head="status (Failed reason)">
  <p class="error">{reason}</p>
</template>
<template head="status (Loaded items)">
  <ul>{map (\item -> <li>{item}</li>) items}</ul>
</template>

<template head="pair (Tuple label (Just n))">
  <p>{label}: {show n}</p>
</template>
<template head="pair (Tuple label Nothing)">
  <p>{label}</p>
</template>

<template head="badge n | n > 99">
  <span class="badge">99+</span>
</template>
<template head="badge n | n > 0, n < 10">
  <span class="badge">{show n}</span>
</template>
<template head="badge _">
  <span class="badge">{"many"}</span>
</template>
