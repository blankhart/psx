<script type="text/purescript">
module App.Counter where

import Prelude

import Data.Array ((..))
import Portico.Psx (Markup)

type Props = { label :: String, max :: Int }

data Msg = Increment | Decrement | Reset

foreign import view :: Props -> Int -> Markup Msg
</script>

<template head="view props n">
  <section class="counter">
    <h2>{props.label}: {show n}</h2>
    <button onclick={Decrement} disabled={n <= 0}>-</button>
    <button onclick={Increment} disabled={n >= props.max}>+</button>
    {
      if n == 0 then
        <></>
      else
        <button onclick={Reset}>Reset</button>
    }
    <ol class="pips">
      {
        map
          ( \i ->
              <li key={i} class={if i <= n then "pip filled" else "pip"}></li>
          )
          (1 .. props.max)
      }
    </ol>
  </section>
</template>

<style>
  .counter { display: grid; gap: 0.75rem; }
  .pip { width: 1rem; height: 0.25rem; background: silver; }
  .pip.filled { background: seagreen; }
</style>
