-- Generated by psx from input.psx
module Lower.KeyedByType where
import Prelude

import Data.Array as Array
import Portico.Psx (Markup)
import Portico.Psx as B
-- The lowering can't see that `item` makes keyed children, and needn't:
-- the hole is `B.children` either way, and its type keys the list.
list :: Array Int -> Markup Unit
list values =
  [ B.div [ B.class_ "list" ] (B.children (Array.mapWithIndex item values)) ]
  where
  item index value = [ B.keyed (show value) (B.div [] (B.children (show index))) ]

-- No children at all is `B.none`.
empty :: Markup Unit
empty = [ B.div [] ([ B.input [ B.type' "text" ] B.none ]) ]
