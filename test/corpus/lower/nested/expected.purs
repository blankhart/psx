-- Generated by psx from input.psx
module Lower.Nested where
import Prelude

import Data.Maybe (Maybe(..))
import Portico.Psx (Markup)
import Portico.Psx as B
-- Holes hold PureScript, which holds markup again, to any depth.
view :: Maybe String -> Array String -> Markup Unit
view user names =
  [ B.section [] (B.children (
     case user of
      Just name -> [ B.p [] ([ B.text "Signed in as ", B.b [] (B.children (name)) ]) ]
      Nothing -> [ B.p [] (B.children (map (\n -> [ B.span [ B.titleAttr (n) ] (B.children (n)) ]) names)) ])

   ) ]
