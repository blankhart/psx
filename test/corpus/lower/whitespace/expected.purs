-- Generated by psx from input.psx
module Lower.Whitespace where
import Prelude

import Portico.Psx (Markup)
import Portico.Psx as B
-- Leading whitespace goes on every line but the first, trailing on every line
-- but the last; empty lines go; the rest are joined by one space.
paragraph :: String -> Markup Unit
paragraph name =
  [ B.p [] ([
    B.text "Hello," ] <> B.children (
       name) <> [ B.text "!   How are you? Fine.",



    B.b [] ([ B.text " bold " ]), B.text " ", B.i [] ([ B.text "italic" ]) ]
   ) ]

-- Text that is only indentation between tags makes no node.
list :: Markup Unit
list =
  [ B.ul [] ([
    B.li [] ([ B.text "one" ]),
    B.li [] ([ B.text "two" ]) ]
   ) ]

-- Text in <pre> follows the same policy; a hole keeps a string as it is.
pre :: Markup Unit
pre = [ B.pre [] (B.children ("  two\n  lines")) ]
