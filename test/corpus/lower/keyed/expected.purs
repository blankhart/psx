-- Generated by psx from input.psx
module Lower.Keyed where
import Prelude

import Data.Tuple (Tuple)
import Portico.Psx (Key, Markup, Node)
import Portico.Psx as B
type Item = { id :: Int, name :: String }

-- A hole whose literals carry `key` makes its parent a keyed element.
list :: Array Item -> Markup Unit
list items =
  [ B.ul [ B.class_ "items" ] (B.children (
     map (\item -> [ B.keyed (item.id) (B.li [] (B.children (item.name))) ]) items)
   ) ]

-- Children that carry `key` themselves.
fixed :: Markup Unit
fixed =
  [ B.ol [] ([
    B.keyed "a" (B.li [] ([ B.text "A" ])),
    B.keyed "b" (B.li [] ([ B.text "B" ])) ]
   ) ]

-- A literal whose root carries `key` is keyed children, for a keyed parent
-- elsewhere.
pair :: Array (Tuple Key (Node Unit))
pair = [ B.keyed "x" (B.li [] ([ B.text "X" ])), B.keyed "y" (B.li [] ([ B.text "Y" ])) ]
