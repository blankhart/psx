module Lower.SvgAttributes where

import Portico.Psx (Markup)

-- HTML's `width` and `height` are whole numbers and SVG's are lengths, so
-- inside <svg> they are svgWidth and svgHeight; SVG's `class` is svgClass.
figure :: forall a. Markup a
figure =
  <figure class="chart">
    <img src="chart.png" width="640" height="480">
    <svg class="plot" width="100%" height="10em">
      <rect class="bar" width="4" height="8"/>
      <foreignObject>
        <canvas class="overlay" width="10"></canvas>
      </foreignObject>
    </svg>
  </figure>
