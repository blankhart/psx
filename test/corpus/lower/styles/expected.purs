module App.Styles where
import Prelude
import Portico.Psx (Markup)
import Portico.Psx as B
import App.Styles.PsxStyle as B.Style
view :: Int -> Markup Unit
view n =
  [ B.main [ B.class_ "page", B.attribute "data-psx" B.Style.scope ] ([



    B.ul [ B.class_ "list", B.attribute "data-psx" B.Style.scope2 ] (B.children (
       map item [ 1, 2, n ])

   ) ]
   ) ]
  where
  item i =
    [ B.li [ B.attribute "data-psx" B.Style.scope3 ] (B.children (
       show i)



     ) ]
