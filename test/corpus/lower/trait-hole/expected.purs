-- Generated by psx from input.psx
module Lower.TraitHole where
import Prelude

import Data.Maybe (Maybe(..))
import Portico as P
import Portico.Psx (Markup)
import Portico.Psx as B
data Msg = Open Boolean | Clicked

-- A trait hole is one element of the attribute array, at its position.
list :: Markup Msg
list = [ B.div [ (P.transitionGroup "bounce"), B.class_ "list" ] ([ B.text "x" ]) ]

check :: Boolean -> Markup Msg
check open =
  [ B.input [ B.type' "checkbox", B.checked (open), (P.onCheck Open) ] B.none ]

-- `key` keys the element; a trait hole beside it is just an attribute.
label :: Markup Msg
label =
  [ B.svg [ B.viewBox "0 0 10 10" ] ([
    B.keyed "text" (B.textEl [ (P.transition "fade"), B.fontSize "24" ] ([ B.text "Hi" ])) ]
   ) ]

-- On lines of their own, each expression keeps its line.
button :: Markup Msg
button =
  [ B.button [
    B.class_ "go",
    (P.onWith "click"
      { capture: true, passive: true }
      \_ -> pure (Just Clicked)) ] ([

    B.text "Go" ]
   ) ]
