module Lower.Entities where

import Portico.Psx (Markup)

-- Character references decode in text and in quoted attribute values; a `&`
-- that starts none is text.
view :: Markup Unit
view =
  <p title="Tom &amp; Jerry &quot;live&quot;">
    &lt;tag&gt; &copy; 2026 &#8212; &#x1F600; &unknown; a & b "quoted"
    back\slash
  </p>
