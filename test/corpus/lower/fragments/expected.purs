module Lower.Fragments where
import Prelude

import Portico.Psx (Markup)
import Portico.Psx as B
-- A fragment is its children, with no wrapper; the empty fragment is [].
both :: Boolean -> Markup Unit
both flag =
  [
    B.h1 [] ([ B.text "Title" ]) ] <> B.children (
     if flag then [ B.p [] ([ B.text "On" ]) ] else []) <> [

      B.span [] ([ B.text "nested" ]) ]



empty :: Markup Unit
empty = []
