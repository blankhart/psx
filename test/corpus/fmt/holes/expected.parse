print: identical
errors: none
markup:
  10:11 <p>
    hole {show   n}
    text " items"
  16:3 <ul>
    text "\n    "
    hole {map (\x -> <li class="item">{x}</li>) xs}
      17:17 <li>
        @class="item"
        hole {x}
    text "\n    "
    hole {if Array.null xs then <li class="empty">Nothing here yet, add something to get started</li> else <></>}
      18:28 <li>
        @class="empty"
        text "Nothing here yet, add something to get started"
      18:103 <>
    text "\n  "
  24:3 <p>
    hole {-- the count show n}
  30:14 <div>
    @class={if open then "open" else "closed"}
    @hidden={not open}
  34:13 <p>
    hole {-n}
    text " and "
    hole {{- a block comment -} n}
