{
  "name": "psx-workspace",
  "private": true,
  "description": "PSX: mixed markup and PureScript",
  "workspaces": [
    "editors/*"
  ],
  "scripts": {
    "build": "spago build",
    "test": "spago test",
    "corpus": "spago run -p psx-corpus --",
    "corpus:accept": "spago run -p psx-corpus -- --accept",
    "psx": "node packages/psx-cli/bin/psx.mjs",
    "examples:portico": "node packages/psx-cli/bin/psx.mjs build examples/portico/src && spago build -p psx-examples-portico && node examples/portico/scripts/build-examples.mjs && node examples/portico/scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@webref/events": "1.27.1",
    "@webref/idl": "3.85.2",
    "esbuild": "0.28.2",
    "html-element-attributes": "3.5.0",
    "html-tag-names": "2.1.0",
    "html-void-elements": "3.0.0",
    "property-information": "7.2.0",
    "puppeteer-core": "25.13.0",
    "purescript": "0.15.15",
    "snabbdom": "3.6.4",
    "spago": "1.0.5",
    "svg-element-attributes": "2.2.0",
    "svg-tag-names": "3.0.1"
  }
}
