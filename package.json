{
  "name": "psx-workspace",
  "private": true,
  "description": "PSX: mixed markup and PureScript",
  "workspaces": [
    "editors/*"
  ],
  "scripts": {
    "build": "spago build",
    "test": "spago test",
    "corpus": "spago run -p psx-corpus --",
    "corpus:accept": "spago run -p psx-corpus -- --accept"
  },
  "devDependencies": {
    "@webref/events": "1.27.1",
    "@webref/idl": "3.85.2",
    "html-element-attributes": "3.5.0",
    "html-tag-names": "2.1.0",
    "html-void-elements": "3.0.0",
    "property-information": "7.2.0",
    "purescript": "0.15.15",
    "spago": "1.0.5",
    "svg-element-attributes": "2.2.0",
    "svg-tag-names": "3.0.1"
  }
}
