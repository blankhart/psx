{
  "name": "PSX",
  "scopeName": "source.psx",
  "fileTypes": [
    "psx"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "injections": {
    "L:source.psx - comment - string - meta.markup.psx": {
      "patterns": [
        {
          "include": "#lexical"
        },
        {
          "include": "#expression-markup"
        }
      ]
    }
  },
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#lexical"
        },
        {
          "include": "#expression-markup"
        },
        {
          "include": "source.purescript"
        }
      ]
    },
    "lexical": {
      "patterns": [
        {
          "include": "source.purescript#string_triple_quoted"
        },
        {
          "include": "source.purescript#string_single_quoted"
        },
        {
          "name": "string.quoted.double.purescript",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "source.purescript#characters"
            },
            {
              "begin": "\\\\\\s*$",
              "end": "^\\s*\\\\|(?=\\S)",
              "name": "constant.character.escape.purescript"
            }
          ]
        },
        {
          "name": "comment.line.double-dash.purescript",
          "begin": "--",
          "end": "$"
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.purescript",
      "begin": "\\{-",
      "end": "-\\}|(?=^[\\p{Ll}_][\\w\\x27]*[^\\n]*?=)|(?=</(?:template|script)\\s*>)",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "expression-markup": {
      "name": "meta.markup.psx",
      "begin": "(?:(?:(?<=[=\\(\\[,{])|(?<=[!#$%&*+./<=>?@\\\\^|~:\\-])|(?<=\\bthen)|(?<=\\belse)|(?<=\\bof)|(?<=\\bin)|^)\\s*(?=<(?:[a-zA-Z][a-zA-Z0-9_.:-]*\\b|>))|([!#$%&*+./<=>?@\\\\^|~:\\-]+)(?=<(?:[a-zA-Z][a-zA-Z0-9_.:-]*\\b|>)))",
      "end": "(?!\\G)(?<=>)|(?=^[\\p{Ll}_][\\w\\x27]*[^\\n]*?=)|(?=</(?:template|script)\\s*>)",
      "patterns": [
        {
          "include": "#markup"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.purescript"
        }
      }
    },
    "hole": {
      "name": "meta.hole.psx",
      "contentName": "meta.embedded.expression.psx source.purescript",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.psx"
        }
      },
      "end": "\\}|(?=^[\\p{Ll}_][\\w\\x27]*[^\\n]*?=)|(?=</(?:template|script)\\s*>)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.psx"
        }
      },
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "#code"
        }
      ]
    },
    "braces": {
      "name": "meta.braces.psx",
      "begin": "\\{(?!-)",
      "end": "\\}|(?=^[\\p{Ll}_][\\w\\x27]*[^\\n]*?=)|(?=</(?:template|script)\\s*>)",
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "#code"
        }
      ]
    },
    "entities": {
      "match": "&(?:[a-zA-Z][a-zA-Z0-9]*|#[0-9]+|#x[0-9a-fA-F]+);",
      "name": "constant.character.entity.html"
    },
    "attributes": {
      "patterns": [
        {
          "include": "#hole"
        },
        {
          "match": "[a-zA-Z_:][\\w:.-]*",
          "name": "entity.other.attribute-name.html"
        },
        {
          "match": "=",
          "name": "punctuation.separator.key-value.html"
        },
        {
          "name": "string.quoted.double.html",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#entities"
            }
          ]
        },
        {
          "name": "string.quoted.single.html",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "include": "#entities"
            }
          ]
        }
      ]
    },
    "opening-tail": {
      "begin": "\\G",
      "end": "(/?>)|(?=</)|(?=^[\\p{Ll}_][\\w\\x27]*[^\\n]*?=)|(?=</(?:template|script)\\s*>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "patterns": [
        {
          "include": "#attributes"
        }
      ]
    },
    "html-comment": {
      "name": "comment.block.html",
      "begin": "<!--",
      "end": "-->|(?=^[\\p{Ll}_][\\w\\x27]*[^\\n]*?=)|(?=</(?:template|script)\\s*>)"
    },
    "style": {
      "name": "meta.style.psx",
      "begin": "(<)(style)\\b[^>]*?(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(</)(style)\\s*(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "contentName": "meta.embedded.block.css.psx source.css",
      "patterns": [
        {
          "include": "source.css"
        }
      ]
    },
    "raw": {
      "name": "meta.embedded.block.raw.psx",
      "begin": "(<)(script|textarea|title)\\b[^>]*?(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(</)(\\2)\\s*(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      }
    },
    "void": {
      "name": "meta.tag.void.psx",
      "begin": "(<)((?:area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr))(?=[\\s/>])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        }
      },
      "end": "/?>|(?=^[\\p{Ll}_][\\w\\x27]*[^\\n]*?=)|(?=</(?:template|script)\\s*>)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "patterns": [
        {
          "include": "#attributes"
        }
      ]
    },
    "element": {
      "name": "meta.element.psx",
      "begin": "(<)([a-zA-Z][a-zA-Z0-9_.:-]*)(?=[\\s/>]|$)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        }
      },
      "end": "(</)(\\2)\\b[^>\\n]*(>|$)|(?<=/>)|(?=^[\\p{Ll}_][\\w\\x27]*[^\\n]*?=)|(?=</(?:template|script)\\s*>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "patterns": [
        {
          "include": "#opening-tail"
        },
        {
          "include": "#markup"
        }
      ]
    },
    "fragment": {
      "name": "meta.fragment.psx",
      "begin": "<>",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.tag.begin.psx"
        }
      },
      "end": "</>|(?=^[\\p{Ll}_][\\w\\x27]*[^\\n]*?=)|(?=</(?:template|script)\\s*>)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.end.psx"
        }
      },
      "patterns": [
        {
          "include": "#markup"
        }
      ]
    },
    "markup": {
      "patterns": [
        {
          "include": "#html-comment"
        },
        {
          "include": "#style"
        },
        {
          "include": "#raw"
        },
        {
          "include": "#void"
        },
        {
          "include": "#fragment"
        },
        {
          "include": "#element"
        },
        {
          "include": "#hole"
        },
        {
          "include": "#entities"
        }
      ]
    }
  }
}
