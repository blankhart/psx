-- | Scoped styles. A `<style>` element's text is extracted to a stylesheet
-- | whose rules are wrapped in native `@scope`, rooted at the element that
-- | carries `data-psx="<scope>"`; class names are left as written.
-- |
-- | Inside `@scope`, a selector without `:scope` or `&` only matches
-- | descendants of the scoping root, so `.counter { ... }` would miss the
-- | `<section class="counter">` the style belongs to. Each such selector `S`
-- | is therefore also written as `:scope:is(S)`, which matches the root
-- | itself when `S` does. At-rules that cannot be scoped (`@keyframes`,
-- | `@font-face`, `@import` and the like) are moved in front of the
-- | `@scope` block unchanged.
-- |
-- | A module with styles gets a companion module, `<Module>.PsxStyle`, whose
-- | foreign file imports the stylesheet and exports each scope's name. The
-- | lowered module imports it as `B.Style` and stamps `B.Style.scope` (then
-- | `scope2`, ...), so a bundler that keeps the module keeps its CSS.
module Psx.Lower.Css
  ( Scope
  , scopeValue
  , scopeName
  , companionModule
  , companionAlias
  , stylesheet
  , scoped
  , companionPurs
  , companionForeign
  ) where

import Prelude

import Data.Array as Array
import Data.Foldable (foldMap)
import Data.Maybe (Maybe(..), fromMaybe)
import Data.String as String
import Data.String.CodeUnits as SCU
import Data.String.Regex (match) as Regex
import Data.String.Regex.Flags (ignoreCase) as Regex
import Data.String.Regex.Unsafe (unsafeRegex) as Regex
import Data.Array.NonEmpty as NonEmptyArray

-- | One stylesheet scope: the CSS of the `<style>` elements that share a
-- | root.
type Scope =
  { -- | 0 for the module's first scope, then 1, 2, ...
    index :: Int
  , css :: String
  }

-- | The `data-psx` value of a module's scope: the module name, then
-- | `<module>-2`, `<module>-3`, ... Module names are unique in a program, so
-- | scopes are too.
scopeValue :: String -> Int -> String
scopeValue moduleName index = if index == 0 then moduleName else moduleName <> "-" <> show (index + 1)

-- | The companion's export for a scope: `scope`, `scope2`, ...
scopeName :: Int -> String
scopeName index = if index == 0 then "scope" else "scope" <> show (index + 1)

companionModule :: String -> String
companionModule moduleName = moduleName <> ".PsxStyle"

-- | The alias the lowered module imports the companion as.
companionAlias :: String
companionAlias = "B.Style"

-- | The stylesheet for a module's scopes.
stylesheet :: { sourceName :: String, moduleName :: String } -> Array Scope -> String
stylesheet names scopes =
  "/* Generated by psx from " <> names.sourceName <> " */\n"
    <> foldMap (\s -> "\n" <> scoped (scopeValue names.moduleName s.index) s.css) scopes

companionPurs :: { sourceName :: String, moduleName :: String } -> Array Scope -> String
companionPurs names scopes = String.joinWith "\n"
  ( [ "-- Generated by psx from " <> names.sourceName
    , "module " <> companionModule names.moduleName <> " (" <> String.joinWith ", " (map (scopeName <<< _.index) scopes) <> ") where"
    , ""
    , "-- | The `data-psx` values that root " <> names.moduleName <> "'s styles. The foreign"
    , "-- | file also imports the stylesheet, so whatever bundles this module"
    , "-- | bundles the CSS."
    ]
      <> map (\s -> "foreign import " <> scopeName s.index <> " :: String") scopes
  ) <> "\n"

-- | `cssImport` is the stylesheet's path relative to the companion's
-- | compiled `foreign.js`.
companionForeign :: { sourceName :: String, moduleName :: String, cssImport :: String } -> Array Scope -> String
companionForeign names scopes = String.joinWith "\n"
  ( [ "// Generated by psx from " <> names.sourceName
    , "import " <> show names.cssImport <> ";"
    , ""
    ]
      <> map (\s -> "export const " <> scopeName s.index <> " = " <> show (scopeValue names.moduleName s.index) <> ";") scopes
  ) <> "\n"

-- | One `<style>`'s text, scoped to the elements carrying `data-psx` with
-- | the value.
scoped :: String -> String -> String
scoped value css = do
  let
    items = scan (dedent css)
    hoisted = Array.filter isHoisted items
    rest = Array.filter (not <<< isHoisted) items
    body = tidyBlankLines (foldMap (printItem true) rest)
  foldMap (\i -> printItem false i <> "\n") hoisted
    <> "@scope ([data-psx="
    <> show value
    <> "]) {\n"
    <> indent body
    <> "}\n"

-- Items ------------------------------------------------------------------------

data Item
  = Space String
  | Comment String
  -- | `@name prelude;`
  | AtStatement String String
  -- | `@name prelude { block }`, with the block's text between the braces
  | AtBlock String String String
  -- | `prelude { block }`
  | Rule String String
  -- | Text that ends before its `{` or `}` does.
  | Other String

isHoisted :: Item -> Boolean
isHoisted = case _ of
  AtStatement _ _ -> true
  AtBlock name _ _ -> Array.elem (String.toLower name) hoistedBlocks || String.contains (String.Pattern "keyframes") (String.toLower name)
  _ -> false

-- | Block at-rules that hold no style rules, or that `@scope` may not
-- | contain. Every statement at-rule (`@import`, `@layer a, b;`) goes too.
hoistedBlocks :: Array String
hoistedBlocks = [ "font-face", "property", "counter-style", "font-feature-values", "font-palette-values", "page", "view-transition" ]

-- | At-rules whose blocks hold style rules, which are scoped in turn.
groupingRules :: Array String
groupingRules = [ "media", "supports", "container", "layer", "starting-style" ]

printItem :: Boolean -> Item -> String
printItem rewrite = case _ of
  Space s -> s
  Comment s -> s
  AtStatement name prelude -> "@" <> name <> prelude <> ";"
  AtBlock name prelude block
    | rewrite && Array.elem (String.toLower name) groupingRules ->
        "@" <> name <> prelude <> "{" <> foldMap (printItem true) (scan block) <> "}"
    | otherwise -> "@" <> name <> prelude <> "{" <> block <> "}"
  Rule prelude block
    | rewrite -> rewriteSelectors prelude <> "{" <> block <> "}"
    | otherwise -> prelude <> "{" <> block <> "}"
  Other s -> s

scan :: String -> Array Item
scan text = go 0 []
  where
  len = SCU.length text
  at i = SCU.charAt i text
  starts i s = SCU.slice i (i + SCU.length s) text == s

  go i acc
    | i >= len = acc
    | otherwise = case at i of
        Just c
          | isSpace c -> do
              let j = spanWhile isSpace i
              go j (Array.snoc acc (Space (SCU.slice i j text)))
        _
          | starts i "/*" -> do
              let j = commentEnd i
              go j (Array.snoc acc (Comment (SCU.slice i j text)))
        Just '@' -> do
              let
                nameEnd = spanWhile isNameChar (i + 1)
                name = SCU.slice (i + 1) nameEnd text
                j = preludeEnd nameEnd
                prelude = SCU.slice nameEnd j text
              case at j of
                Just ';' -> go (j + 1) (Array.snoc acc (AtStatement name prelude))
                Just '{' -> do
                  let k = blockEnd (j + 1)
                  go (min len (k + 1)) (Array.snoc acc (AtBlock name prelude (SCU.slice (j + 1) k text)))
                _ -> go j (Array.snoc acc (Other (SCU.slice i j text)))
        _ -> do
          let j = preludeEnd i
          case at j of
            Just '{' -> do
              let k = blockEnd (j + 1)
              go (min len (k + 1)) (Array.snoc acc (Rule (SCU.slice i j text) (SCU.slice (j + 1) k text)))
            _ -> do
              let k = max (i + 1) (min len (j + 1))
              go k (Array.snoc acc (Other (SCU.slice i k text)))

  spanWhile p i = case at i of
    Just c | p c -> spanWhile p (i + 1)
    _ -> i

  commentEnd i = case SCU.indexOf (String.Pattern "*/") (SCU.drop (i + 2) text) of
    Just k -> i + 2 + k + 2
    Nothing -> len

  stringEnd q i = case at i of
    Nothing -> len
    Just '\\' -> stringEnd q (i + 2)
    Just c
      | c == q -> i + 1
      | c == '\n' -> i
      | otherwise -> stringEnd q (i + 1)

  -- The offset of the `;`, `{` or `}` that ends a prelude at depth 0.
  preludeEnd i = case at i of
    Nothing -> len
    Just c
      | c == ';' || c == '{' || c == '}' -> i
      | c == '"' || c == '\'' -> preludeEnd (stringEnd c (i + 1))
      | c == '(' || c == '[' -> preludeEnd (closing i)
      | starts i "/*" -> preludeEnd (commentEnd i)
      | otherwise -> preludeEnd (i + 1)

  -- Just after the bracket that closes the one at the offset.
  closing i = inner 0 i
    where
    inner depth j = case at j of
      Nothing -> len
      Just c
        | c == '(' || c == '[' -> inner (depth + 1) (j + 1)
        | c == ')' || c == ']' -> if depth <= 1 then j + 1 else inner (depth - 1) (j + 1)
        | c == '"' || c == '\'' -> inner depth (stringEnd c (j + 1))
        | starts j "/*" -> inner depth (commentEnd j)
        | otherwise -> inner depth (j + 1)

  -- The offset of the `}` that closes a block whose text starts at the
  -- offset.
  blockEnd i = inner 0 i
    where
    inner depth j = case at j of
      Nothing -> len
      Just c
        | c == '{' -> inner (depth + 1) (j + 1)
        | c == '}' -> if depth == 0 then j else inner (depth - 1) (j + 1)
        | c == '"' || c == '\'' -> inner depth (stringEnd c (j + 1))
        | starts j "/*" -> inner depth (commentEnd j)
        | otherwise -> inner depth (j + 1)

isSpace :: Char -> Boolean
isSpace c = c == ' ' || c == '\n' || c == '\r' || c == '\t' || c == '\x0c'

isNameChar :: Char -> Boolean
isNameChar c = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_'

-- Selectors --------------------------------------------------------------------

-- | A rule's selector list, each selector also matching the scoping root.
rewriteSelectors :: String -> String
rewriteSelectors prelude = do
  let
    trimmed = trimEnd prelude
    trailing = SCU.drop (SCU.length trimmed) prelude
    extra = Array.mapMaybe atRoot (map String.trim (splitTopLevel trimmed))
  if Array.null extra then prelude
  else trimmed <> foldMap (", " <> _) extra <> trailing

-- | The selector, as one that matches the scoping root itself, unless it
-- | already mentions the root or is relative.
atRoot :: String -> Maybe String
atRoot s
  | s == "" = Nothing
  | String.contains (String.Pattern ":scope") s || String.contains (String.Pattern "&") s = Nothing
  | Array.elem (SCU.take 1 s) [ ">", "+", "~" ] = Nothing
  | otherwise = do
      let
        { base, pseudo } = splitPseudoElement s
        base' = String.trim base
      Just
        if base' == "" || base' == "*" then ":scope" <> pseudo
        else ":scope:is(" <> base' <> ")" <> pseudo

-- | A selector and its trailing pseudo-element, which `:is()` cannot hold.
splitPseudoElement :: String -> { base :: String, pseudo :: String }
splitPseudoElement s = case lastTopLevel "::" s of
  Just i -> { base: SCU.take i s, pseudo: SCU.drop i s }
  Nothing -> case Regex.match legacy s >>= NonEmptyArray.head of
    Just p -> { base: SCU.dropRight (SCU.length p) s, pseudo: p }
    Nothing -> { base: s, pseudo: "" }
  where
  legacy = Regex.unsafeRegex ":(before|after|first-line|first-letter)$" Regex.ignoreCase

-- | Splits at commas outside brackets and strings.
splitTopLevel :: String -> Array String
splitTopLevel s = go 0 0 0 []
  where
  len = SCU.length s
  go start depth i acc
    | i >= len = Array.snoc acc (SCU.drop start s)
    | otherwise = case SCU.charAt i s of
        Just c
          | c == '(' || c == '[' -> go start (depth + 1) (i + 1) acc
          | c == ')' || c == ']' -> go start (max 0 (depth - 1)) (i + 1) acc
          | c == '"' || c == '\'' -> go start depth (skipString c (i + 1)) acc
          | c == ',' && depth == 0 -> go (i + 1) depth (i + 1) (Array.snoc acc (SCU.slice start i s))
        _ -> go start depth (i + 1) acc
  skipString q i = case SCU.charAt i s of
    Nothing -> len
    Just '\\' -> skipString q (i + 2)
    Just c -> if c == q then i + 1 else skipString q (i + 1)

-- | The offset of the last occurrence outside brackets and strings.
lastTopLevel :: String -> String -> Maybe Int
lastTopLevel needle s = go 0 0 Nothing
  where
  len = SCU.length s
  go depth i found
    | i >= len = found
    | otherwise = case SCU.charAt i s of
        Just c
          | c == '(' || c == '[' -> go (depth + 1) (i + 1) found
          | c == ')' || c == ']' -> go (max 0 (depth - 1)) (i + 1) found
          | depth == 0 && SCU.slice i (i + SCU.length needle) s == needle -> go depth (i + SCU.length needle) (Just i)
        _ -> go depth (i + 1) found

-- Text -------------------------------------------------------------------------

-- | Drops leading and trailing blank lines and the indentation every line
-- | shares.
dedent :: String -> String
dedent text = do
  let
    lines = map trimEnd (String.split (String.Pattern "\n") text)
    nonBlank = Array.filter (_ /= "") lines
    common = fromMaybe 0 (Array.head (Array.sort (map indentOf nonBlank)))
    kept = Array.dropWhile (_ == "") (Array.reverse (Array.dropWhile (_ == "") (Array.reverse lines)))
  String.joinWith "\n" (map (SCU.drop common) kept)
  where
  indentOf l = SCU.length l - SCU.length (trimStart l)

-- | At most one blank line in a row, none at either end, and a final line
-- | feed.
tidyBlankLines :: String -> String
tidyBlankLines text = do
  let
    lines = map trimEnd (String.split (String.Pattern "\n") text)
    collapsed = Array.foldl (\acc l -> if l == "" && Array.last acc == Just "" then acc else Array.snoc acc l) [] lines
    kept = Array.dropWhile (_ == "") (Array.reverse (Array.dropWhile (_ == "") (Array.reverse collapsed)))
  if Array.null kept then "" else String.joinWith "\n" kept <> "\n"

indent :: String -> String
indent text
  | text == "" = ""
  | otherwise = foldMap (\l -> (if l == "" then "" else "  " <> l) <> "\n") (Array.dropEnd 1 (String.split (String.Pattern "\n") text))

trimEnd :: String -> String
trimEnd s = case SCU.charAt (SCU.length s - 1) s of
  Just c | isSpace c -> trimEnd (SCU.dropRight 1 s)
  _ -> s

trimStart :: String -> String
trimStart s = case SCU.charAt 0 s of
  Just c | isSpace c -> trimStart (SCU.drop 1 s)
  _ -> s
