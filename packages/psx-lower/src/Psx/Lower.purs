type Lowered =
  { purs :: String
  , positionMap :: PositionMap
  , warnings :: Array PsxError
  -- | The module's scoped styles, if it has any: the stylesheet and the
  -- | companion module the lowered code imports (see `Psx.Lower.Css`).
  , style :: Maybe Style
  }

type Style =
  { moduleName :: String
  , scopes :: Array Scope
  , css :: String
  -- | The companion module's name and its `.purs` text.
  , companion :: String
  , companionPurs :: String
  }

type Names = { sourceName :: String, generatedName :: String }

-- | The modules a `.psx` file may take its markup functions from.
backendModules :: Array String
backendModules = [ "Portico.Psx", "Halogen.Psx", "Screamer.Psx", "Psx.Static", "React.Basic.Hooks.Psx" ]

-- | The first line of every generated file.
header :: String -> String
header sourceName = "-- Generated by psx from " <> sourceName

-- | Whether a `.purs` file's text is one psx wrote.
isGenerated :: String -> Boolean
isGenerated text = SCU.take 25 text == "-- Generated by psx from "

-- | `sourceName` is the name written in the header (the source's file
-- | name) and `generatedName` the name the position map gives the output.
lower :: Names -> String -> Either (Array PsxError) Lowered
lower names text = case parseModule text of
  { module: Just m, errors: [] } -> lowerModule names (source text) m Nothing
  { errors } -> Left errors

-- | Lowers a `.psxt` file. The script's module is copied as a `.psx` module
-- | is; each template's `foreign import f :: T` becomes blank, and the
-- | template is a syntactic transformation: `<template head="H">…</template>`
-- | becomes the equation `H = […]`, its head copied as written, on the lines
-- | of its `<template>` tag. The first equation of `f` is preceded by
-- | `f :: T` (on the blank line before it when there is one). Templates
-- | written before the script follow the last one.
-- | Lines outside the script and the templates are blank.
lowerPsxt :: Names -> String -> Either (Array PsxError) Lowered
lowerPsxt names text = case parsePsxt text of
  { file: Just file, errors: [] } -> do
    let real = source text
    lowerModule names (source (masked file real)) file.script.module (Just { real, file })
  { errors } -> Left errors
  where
  masked file real = do
    let
      spaces = Regex.replace (Regex.unsafeRegex "[^\\r\\n]" Regex.global) " "
      sc = file.script
    spaces (SCU.take sc.contentStart real.text) <> SCU.slice sc.contentStart sc.contentEnd real.text <> spaces (SCU.drop sc.contentEnd real.text)

-- The module -----------------------------------------------------------------

data Event
  -- | Insert text at an offset.
  = Insert Int String
  -- | Leave out the source from one offset to another.
  | Skip Int Int
  -- | Leave out the source from one offset to another but keep its lines.
  | Blank Int Int
  | Lower MarkupRoot
  | LowerTemplate Template

eventOffset :: Source -> Event -> Int
eventOffset src = case _ of
  Insert o _ -> o
  Skip o _ -> o
  Blank o _ -> o
  Lower root -> offsetOf src (rootRange root).start
  LowerTemplate t -> offsetOf src t.element.open.range.start

-- | What a `.psxt` file adds: the file's text (`src` is its script alone)
-- | and its templates.
type PsxtFile = { real :: Source, file :: Psxt }

lowerModule :: Names -> Source -> Module Psx -> Maybe PsxtFile -> Either (Array PsxError) Lowered
lowerModule names src m@(Module { header: ModuleHeader h, body: ModuleBody body }) psxt = do
  let
    backends = Array.filter (\i -> Array.elem (importName i) backendModules) h.imports
    distinct = Array.nub (map importName backends)
    kind = if isJust psxt then ".psxt" else ".psx"
  case distinct of
    [ backend ] -> do
      let
        moduleName = unwrap (unwrap h.name).name
        roots = sortRoots (foldMapModule rootVisitor m)
        templates = maybe [] (_.file.templates) psxt
        styles = collectStyles m psxt
        style = if Array.null styles.scopes then Nothing else Just (styleOf moduleName styles.scopes)
        aliased = any (\i -> importName i == backend && isAlias i) backends
        needsAlias = not aliased && not (Array.null roots && Array.null templates)
        importLine = maybe 0 (\i -> (rangeOf i).end.line) (Array.last backends)
        added =
          (if needsAlias then [ "import " <> backend <> " as B" ] else [])
            <> maybe [] (\sty -> [ "import " <> sty.companion <> " as " <> Css.companionAlias ]) style
        inserts = if Array.null added then [] else [ Insert (lineEnd src importLine) (foldMap ("\n" <> _) added) ]
        -- One blank line for the header (in a .psx file), then one for each
        -- added import, so the lines after the imports keep their numbers.
        removable = removableLines src h body.decls
        forHeader = if isJust psxt then Nothing else Array.head removable
        spare = Array.filter (\l -> Just l /= forHeader) removable
        -- Those after the imports first.
        forImports = Array.take (Array.length added) (Array.filter (_ > importLine) spare <> Array.filter (_ <= importLine) spare)
        skips = (Array.fromFoldable forHeader <> forImports) <#> \l -> Skip (lineStart src l) (lineStart src (l + 1))
        psxtEvents = maybe [] (templateEvents src) psxt
        events = Array.sortWith (eventOffset src) (inserts <> skips <> psxtEvents <> map Lower roots)
        context = baseContext { scopes = styles.byElement }
        st = execState
          ( do
              case psxt of
                Nothing -> emit (header names.sourceName <> "\n")
                Just p -> do
                  emit (header names.sourceName)
                  -- The header takes the script tag's line, unless the module
                  -- starts on it.
                  when (h.keyword.range.start.line == 0) (emit "\n")
                  blank src 0 p.file.script.contentStart
              end <- runEvents src (maybe src _.real psxt) context (fileStamp style) events (maybe 0 (_.file.script.contentStart) psxt)
              case psxt of
                Nothing -> copy src end (SCU.length src.text)
                Just p ->
                  -- Templates before the script follow the others.
                  for_ (Array.filter (\t -> offsetOf src t.element.open.range.start < p.file.script.contentStart) templates) \t -> do
                    trimTrailingSpaces
                    emit "\n"
                    lowerTemplate p.real context (fileStamp style) t
                    trimTrailingSpaces
                    column <- gets _.column
                    when (column > 0) (emit "\n")
          )
          initial { errors = styles.errors }
      case st.errors of
        [] -> Right
          { purs: String.joinWith "" (Array.reverse (List.toUnfoldable st.chunks))
          , positionMap:
              { source: names.sourceName
              , generated: names.generatedName
              , segments: Array.reverse (List.toUnfoldable st.segments)
              }
          , warnings: st.warnings
          , style: style
          }
        errors -> Left errors
    [] -> Left [ moduleError h.name ("A " <> kind <> " file imports its backend: one of ") (Array.intercalate ", " backendModules) ]
    _ -> Left
      [ moduleError h.name ("A " <> kind <> " file imports one backend, but this one imports ") (Array.intercalate " and " distinct) ]
  where
  moduleError name message detail =
    { range: (rangeOf name), message: message <> detail, fix: Nothing }

  styleOf moduleName scopes = do
    let styleNames = { sourceName: names.sourceName, moduleName }
    { moduleName
    , scopes
    , css: Css.stylesheet styleNames scopes
    , companion: Css.companionModule moduleName
    , companionPurs: Css.companionPurs styleNames scopes
    }

  -- A .psxt file's own styles root at each template's top-level elements.
  fileStamp style = case psxt, style of
    Just p, Just _ | not (Array.null p.file.styles) -> Just (Css.companionAlias <> "." <> Css.scopeName 0)
    _, _ -> Nothing

-- | The events of a `.psxt` file after its module: the foreign imports
-- | its templates define go, the templates after the script are lowered in
-- | place, and the rest keeps only its lines.
templateEvents :: Source -> PsxtFile -> Array Event
templateEvents src p = do
  let
    sc = p.file.script
    defined = Array.mapMaybe _.declaration (Array.filter _.first p.file.templates)
    after = Array.filter (\t -> offsetOf src t.element.open.range.start >= sc.contentEnd) p.file.templates
    ends = Array.cons sc.contentEnd (map (\t -> offsetOf src (elementEnd t.element)) after)
    starts = Array.snoc (map (\t -> offsetOf src t.element.open.range.start) after) (SCU.length src.text)
  map (\d -> Skip (offsetOf src d.range.start) (offsetOf src d.range.end)) defined
    <> Array.zipWith Blank ends starts
    <> map LowerTemplate after

elementEnd :: Element Psx -> SourcePos
elementEnd el = case el.close of
  Just c -> maybe c.name.range.end _.range.end c.end
  Nothing -> el.end.range.end

importName :: forall e. ImportDecl e -> String
importName (ImportDecl i) = unwrap (unwrap i.module).name

isAlias :: forall e. ImportDecl e -> Boolean
isAlias (ImportDecl i) = case i.names, i.qualified of
  Nothing, Just (Tuple _ alias) -> unwrap (unwrap alias).name == "B"
  _, _ -> false

-- | Blank lines between the module header and the first declaration that no
-- | block comment spans, so they can go without changing the program.
removableLines :: forall r. Source -> { where :: SourceToken, imports :: Array (ImportDecl Psx) | r } -> Array (Declaration Psx) -> Array Int
removableLines src h decls = do
  let
    tokens = TokenList.toArray (foldMap' tokensOf h.imports)
      <> maybe [] (\d -> Array.take 1 (TokenList.toArray (tokensOf d))) (Array.head decls)
    gaps = Array.zipWith gap (Array.cons h.where tokens) tokens
    gap prev tok
      | any multiline tok.leadingComments = []
      | prev.range.end.line + 1 > tok.range.start.line - 1 = []
      | otherwise = Array.range (prev.range.end.line + 1) (tok.range.start.line - 1)
  Array.filter blankLine (Array.concat gaps)
  where
  foldMap' f = Array.foldl (\acc x -> acc <> f x) mempty
  multiline = case _ of
    Comment c -> String.contains (String.Pattern "\n") c
    _ -> false
  blankLine l = l >= 0 && Array.all isWhitespace (SCU.toCharArray (lineText src l)) && lineStart src (l + 1) > lineStart src l

lineStart :: Source -> Int -> Int
lineStart src l = fromMaybe (SCU.length src.text) (Array.index src.lineStarts l)

-- | The offset of the line feed that ends a line.
lineEnd :: Source -> Int -> Int
lineEnd src l = max (lineStart src l) (lineStart src (l + 1) - 1)

lineText :: Source -> Int -> String
lineText src l = SCU.slice (lineStart src l) (lineEnd src l) src.text

-- | Runs the events from an offset and returns the offset reached.
-- | `templateSrc` is the text templates are lowered from: a `.psxt` file's
-- | own, where `src` is its script alone.
runEvents :: Source -> Source -> Context -> Maybe String -> Array Event -> Int -> M Int
runEvents src templateSrc context stamp events from = Array.foldM step from events
  where
  step at event = do
    let o = eventOffset src event
    copy src at o
    case event of
      Insert _ text -> emit text *> pure o
      Skip _ to -> pure to
      Blank _ to -> do
        blank src o to
        pure to
      Lower root -> do
        lowerRoot src context root
        pure (offsetOf src (rootRange root).end)
      LowerTemplate t -> do
        lowerTemplate templateSrc context stamp t
        pure (offsetOf src (elementEnd t.element))

-- | The line breaks in the source between two offsets.
blank :: Source -> Int -> Int -> M Unit
blank src from to = trimTrailingSpaces *> emit (power "\n" (Array.length (Array.filter (\l -> l > from && l <= to) src.lineStarts)))

-- Styles -----------------------------------------------------------------------

type Styles =
  { scopes :: Array Css.Scope
  -- | The scope each element with a `<style>` child roots.
  , byElement :: Array { at :: SourcePos, index :: Int, range :: SourceRange }
  , errors :: Array PsxError
  }

-- | The scopes of a module: in a `.psxt` file, the top-level `<style>`s
-- | first; then each element with `<style>` children, in source order.
collectStyles :: Module Psx -> Maybe PsxtFile -> Styles
collectStyles m psxt = do
  let
    fileCss = maybe [] (\p -> map styleText p.file.styles) psxt
    fileScope = if Array.null fileCss then [] else [ { index: 0, css: String.joinWith "\n" fileCss } ]
    templates = maybe [] (_.file.templates) psxt
    -- Every root: the module's, and those in templates' holes.
    roots = foldMapMarkupRoots (\r -> [ r ]) m
      <> foldMap (\t -> foldMapHoles (foldMapMarkupRootsExpr (\r -> [ r ]) <<< _.expr) (MarkupElement t.element)) templates
    elements = Array.sortWith (\el -> [ el.open.range.start.line, el.open.range.start.column ])
      ( foldMap (elementsOf <<< _.markup) roots
          <> foldMap (\t -> foldMap childElements t.element.children) templates
      )
    styled = Array.filter (not <<< Array.null <<< _.styles)
      (elements <#> \el -> { element: el, styles: stylesIn el.children })
    first = Array.length fileScope
    byElement = styled # Array.mapWithIndex \i s ->
      { at: s.element.open.range.start
      , index: first + i
      , range: maybe s.element.name.range (\st -> { start: st.open.range.start, end: elementEnd st }) (Array.head s.styles)
      }
    scopes = fileScope <> Array.mapWithIndex (\i s -> { index: first + i, css: String.joinWith "\n" (map styleText s.styles) }) styled
    loose = foldMap looseInRoot roots <> foldMap (\t -> stylesIn t.element.children) templates
    looseErrors = loose <#> \st ->
      { range: { start: st.open.range.start, end: st.name.range.end }
      , message: "A <style> styles the element that contains it, so it must be inside one"
          <> if isJust psxt then ", or at the top of the file to style every template" else ""
      , fix: Nothing
      }
    -- A template's top-level element is already scoped by the file.
    doubled =
      if Array.null fileScope then []
      else styled # Array.filter (\s -> any (\t -> any (\el -> el.open.range == s.element.open.range) (topElements t.element.children)) templates)
        <#> \s ->
          { range: s.element.name.range
          , message: "This element is at the top of a template, so the file's <style> already scopes it; move this <style> to the top of the file"
          , fix: Nothing
          }
  { scopes, byElement, errors: looseErrors <> doubled }
  where
  looseInRoot r = case r.markup of
    MarkupElement el | el.name.text == "style" -> [ el ]
    MarkupElement _ -> []
    MarkupFragment fr -> stylesIn fr.children

  topElements children = Array.mapMaybe
    ( case _ of
        ChildMarkup (MarkupElement el) -> Just el
        _ -> Nothing
    )
    (spliced children)

styleText :: Element Psx -> String
styleText el = foldMap
  ( case _ of
      ChildText t -> t.text
      _ -> ""
  )
  el.children

-- | Children with fragments spliced in.
spliced :: Array (Child Psx) -> Array (Child Psx)
spliced = Array.concatMap case _ of
  ChildMarkup (MarkupFragment fr) -> spliced fr.children
  c -> [ c ]

stylesIn :: Array (Child Psx) -> Array (Element Psx)
stylesIn children = Array.mapMaybe
  ( case _ of
      ChildMarkup (MarkupElement el) | el.name.text == "style" -> Just el
      _ -> Nothing
  )
  (spliced children)

-- | The elements in a markup tree, not counting those in holes.
elementsOf :: Markup Psx -> Array (Element Psx)
elementsOf = case _ of
  MarkupElement el -> Array.cons el (foldMap childElements el.children)
  MarkupFragment fr -> foldMap childElements fr.children

childElements :: Child Psx -> Array (Element Psx)
childElements = case _ of
  ChildMarkup mk -> elementsOf mk
  _ -> []

-- Emitting -------------------------------------------------------------------

type St =
  { chunks :: List String
  , line :: Int
  , column :: Int
  , segments :: List Segment
  , errors :: Array PsxError
  , warnings :: Array PsxError
  }

type M = State St

initial :: St
initial = { chunks: Nil, line: 0, column: 0, segments: Nil, errors: [], warnings: [] }

position :: M SourcePos
position = gets \st -> { line: st.line, column: st.column }

emit :: String -> M Unit
emit "" = pure unit
emit text = modify_ \st -> do
  let lines = String.split (String.Pattern "\n") text
  case Array.last lines of
    Just last | Array.length lines > 1 ->
      st { chunks = text : st.chunks, line = st.line + Array.length lines - 1, column = String.length last }
    _ -> st { chunks = text : st.chunks, column = st.column + String.length text }

-- | Emits code generated for the markup in a source range.
emitFor :: SourceRange -> String -> M Unit
emitFor range text = do
  start <- position
  emit text
  end <- position
  modify_ \st -> st { segments = { kind: Generated, generated: { start, end }, source: range } : st.segments }

-- | Copies the source between two offsets.
copy :: Source -> Int -> Int -> M Unit
copy src from to = when (from < to) do
  let text = SCU.slice from to src.text
  when (SCU.take 1 text == "\n" || SCU.take 2 text == "\r\n") trimTrailingSpaces
  start <- position
  emit text
  end <- position
  let range = { start: posOf src from, end: posOf src to }
  modify_ \st -> st { segments = { kind: Copy, generated: { start, end }, source: range } : st.segments }

failAt :: SourceRange -> String -> M Unit
failAt range message = modify_ \st -> st { errors = Array.snoc st.errors { range, message, fix: Nothing } }

-- | What the code for one literal needs to know about where it sits.
type Context =
  { -- | Generated line minus source line where the literal starts.
    delta :: Int
  -- | The least indentation of a line the lowering starts, which keeps
  -- | it inside the layout block the literal is in.
  , indent :: Int
  , namespace :: Namespace
  , raw :: Boolean
  -- | The elements that root a scope (see `collectStyles`).
  , scopes :: Array { at :: SourcePos, index :: Int, range :: SourceRange }
  -- | The scope a `.psxt` file's top-level elements in a template take,
  -- | and the template.
  , stamp :: Maybe { code :: String, range :: SourceRange }
  }

baseContext :: Context
baseContext = { delta: 0, indent: 1, namespace: Html, raw: false, scopes: [], stamp: Nothing }

-- | Moves to the source position's line (as it maps to the generated file),
-- | and on that line to its column if that is still ahead.
padTo :: Context -> SourcePos -> M Unit
padTo ctx pos = do
  st <- get
  let target = pos.line + ctx.delta
  if st.line < target then do
    trimTrailingSpaces
    emit (power "\n" (target - st.line) <> power " " (max pos.column ctx.indent))
  else if st.column < pos.column then emit (power " " (pos.column - st.column))
  else pure unit

power :: String -> Int -> String
power s n = if n <= 0 then "" else s <> power s (n - 1)

-- | Drops the spaces this lowering left at the end of the line so far.
trimTrailingSpaces :: M Unit
trimTrailingSpaces = modify_ \st -> case st.chunks of
  chunk : rest -> do
    let n = SCU.length chunk - SCU.length (dropTrailing chunk)
    if n > 0 && SCU.take 1 chunk /= "" then st { chunks = SCU.dropRight n chunk : rest, column = st.column - n } else st
  _ -> st
  where
  dropTrailing c = if SCU.takeRight 1 c == " " then dropTrailing (SCU.dropRight 1 c) else c

-- | Whether the line before the current one, which is empty so far, is
-- | empty too.
previousLineBlank :: M Boolean
previousLineBlank = gets \st -> st.column == 0 && st.line > 0 && tail 2 st.chunks == "\n\n"
  where
  tail n chunks = go "" chunks
    where
    go acc = case _ of
      _ | SCU.length acc >= n -> SCU.takeRight n acc
      c : rest -> go (c <> acc) rest
      Nil -> acc

-- | Moves back onto the empty line before the current one.
retreat :: M Unit
retreat = modify_ \st -> case st.chunks of
  chunk : rest | SCU.takeRight 1 chunk == "\n" -> st { chunks = SCU.dropRight 1 chunk : rest, line = st.line - 1, column = 0 }
  _ -> st

-- Templates --------------------------------------------------------------------

-- | `f :: T` before a function's first equation, then `f args =` for the
-- | template and its children as a literal.
lowerTemplate :: Source -> Context -> Maybe String -> Template -> M Unit
lowerTemplate src outer stamp t = for_ t.declaration \decl -> do
  let
    el = t.element
    tagRange = { start: el.open.range.start, end: el.end.range.end }
    tagLine = el.open.range.start.line
  st0 <- get
  when t.first do
    blankBefore <- previousLineBlank
    if blankBefore then retreat else when (st0.column > 0) (emit "\n")
    emitFor tagRange t.name
    emit " :: "
    copy src (offsetOf src (rangeOf decl.type).start) (offsetOf src (rangeOf decl.type).end)
    emit "\n"
  unless t.first (when (st0.column > 0) (emit "\n"))
  emitFor tagRange t.name
  for_ t.args \a -> when (String.trim a.text /= "") do
    emit " "
    copy src a.start a.end
  emit " ="
  st <- get
  let
    ctx = outer
      { delta = st.line - tagLine
      , indent = 1
      , namespace = Html
      , raw = false
      , stamp = stamp <#> \code -> { code, range: tagRange }
      }
    children = items src ctx el.children
  case Array.head children of
    Nothing -> emit " []"
    Just first -> do
      padTo ctx case first of
        ItemText _ pos _ -> pos
        ItemElement e -> e.open.range.start
        ItemHole h -> h.open.range.start
      moved <- gets \st' -> st'.line /= st.line || st'.column /= st.column
      unless moved (emit " ")
      emitChildren src ctx children
  for_ el.close \c -> padTo ctx { line: c.open.range.start.line, column: 0 }

-- Markup ---------------------------------------------------------------------

rootVisitor :: { onBinder :: Binder Psx -> Array MarkupRoot, onDecl :: Declaration Psx -> Array MarkupRoot, onExpr :: Expr Psx -> Array MarkupRoot, onType :: CST.Type Psx -> Array MarkupRoot }
rootVisitor = defaultMonoidalVisitor
  { onExpr = case _ of
      ExprError (PsxMarkup root) -> [ root ]
      _ -> []
  }

-- | The literals in an expression, not counting those inside them.
rootsIn :: Expr Psx -> Array MarkupRoot
rootsIn = sortRoots <<< foldMapExpr rootVisitor

sortRoots :: Array MarkupRoot -> Array MarkupRoot
sortRoots = Array.sortWith \r -> let s = (rootRange r).start in [ s.line, s.column ]

rootRange :: MarkupRoot -> SourceRange
rootRange root = rangeOf (PsxMarkup root)

lowerRoot :: Source -> Context -> MarkupRoot -> M Unit
lowerRoot src outer root = do
  st <- get
  let
    start = (rootRange root).start
    ctx = outer
      { delta = st.line - start.line
      , indent = max outer.indent (firstColumn src start.line + 1)
      }
  case root.markup of
    MarkupElement el
      | Just k <- keyOf el -> do
          emit "[ "
          emitKeyed src ctx k el
          emit " ]"
      | otherwise -> do
          emit "[ "
          emitElement src ctx el
          emit " ]"
    MarkupFragment fr -> do
      emitChildren src ctx (items src ctx fr.children)
      -- Back to the line the literal ends on, so the source after it keeps
      -- its line.
      padTo ctx { line: (rootRange root).end.line, column: 0 }

-- | The column of the first character on a line that is not whitespace.
firstColumn :: Source -> Int -> Int
firstColumn src l = String.length (SCU.takeWhile isWhitespace (lineText src l))

-- | A hole's expression, with the literals in it lowered in turn.
emitHole :: Source -> Context -> Hole Psx -> M Unit
emitHole src ctx h = do
  let range = rangeOf h.expr
  padTo ctx range.start
  end <- runEvents' (rootsIn h.expr) (offsetOf src range.start)
  copy src end (offsetOf src range.end)
  where
  runEvents' roots from = Array.foldM step from roots
  step at root = do
    copy src at (offsetOf src (rootRange root).start)
    lowerRoot src ctx root
    pure (offsetOf src (rootRange root).end)

data Item
  -- | Text after the whitespace policy, and where it starts.
  = ItemText MToken SourcePos String
  | ItemElement (Element Psx)
  | ItemHole (Hole Psx)

-- | The children that make nodes: fragments are spliced, comments and
-- | whitespace that the policy removes are dropped.
items :: Source -> Context -> Array (Child Psx) -> Array Item
items src ctx = Array.concatMap case _ of
  ChildText t -> do
    let text = if ctx.raw then t.text else Entities.decode (Whitespace.normalise t.text)
    if text == "" then []
    else do
      let lead = SCU.length (SCU.takeWhile isWhitespace t.text)
      [ ItemText t (posOf src (offsetOf src t.range.start + if ctx.raw then 0 else lead)) text ]
  -- A `<style>` goes to the stylesheet (see `collectStyles`).
  ChildMarkup (MarkupElement el)
    | el.name.text == "style" -> []
    | otherwise -> [ ItemElement el ]
  ChildMarkup (MarkupFragment fr) -> items src ctx fr.children
  ChildHole h -> [ ItemHole h ]
  ChildComment _ -> []
  ChildRaw _ -> []

-- | Whether children are a keyed list: some child element carries `key`,
-- | or some hole holds a literal that does.
keyedItems :: Source -> Context -> Array Item -> Boolean
keyedItems src ctx = any case _ of
  ItemElement el -> isJust (keyOf el)
  ItemHole h -> any (rootKeyed src ctx) (rootsIn h.expr)
  ItemText _ _ _ -> false

rootKeyed :: Source -> Context -> MarkupRoot -> Boolean
rootKeyed src ctx root = case root.markup of
  MarkupElement el -> isJust (keyOf el)
  MarkupFragment fr -> keyedItems src ctx (items src ctx fr.children)

keyOf :: Element Psx -> Maybe (NamedAttr Psx)
keyOf el = Array.find (\a -> a.name.text == "key") (namedAttrs el.attrs)

-- | Children as one expression: runs of nodes in array literals, holes
-- | through `B.children`, joined with `<>`. Whether they are keyed decides
-- | nothing here but the checks that keyed siblings all carry `key`.
emitChildren :: Source -> Context -> Array Item -> M Unit
emitChildren src ctx children = do
  let keyedList = keyedItems src ctx children
  if Array.null children then emit "[]"
  else do
    inArray <- Array.foldM (step keyedList) Nothing (Array.mapWithIndex Tuple children)
    when (inArray == Just true) (emit " ]")
  where
  -- Nothing before the first item; then whether an array literal is open.
  step keyedList open (Tuple _ item) = case item of
    ItemHole h -> do
      when (open == Just true) (emit " ]")
      when (isJust open) (emit " <>")
      emit (if isJust open then " " else "")
      emitFor (holeRange h) "B.children ("
      emitHole src ctx h
      emit ")"
      pure (Just false)
    _ -> do
      case open of
        Just true -> emit ","
        Just false -> emit " <> ["
        Nothing -> emit "["
      emit " "
      case item of
        ItemText t start text -> do
          padTo ctx start
          if keyedList then failAt t.range "Text cannot be a child of a keyed list: every child must carry `key`"
          else emitFor t.range ("B.text " <> stringLiteral text)
        ItemElement el -> do
          padTo ctx el.open.range.start
          case keyOf el of
            Just k -> emitKeyed src ctx k el
            Nothing -> do
              when keyedList (failAt el.name.range "This element is in a keyed list, so it must carry `key` as its siblings do")
              emitElement src ctx el
        ItemHole _ -> pure unit
      pure (Just true)

holeRange :: Hole Psx -> SourceRange
holeRange h = { start: h.open.range.start, end: h.close.range.end }

emitKeyed :: Source -> Context -> NamedAttr Psx -> Element Psx -> M Unit
emitKeyed src ctx k el = do
  emitFor k.name.range "B.keyed "
  case k.value of
    Just { value: AttrHole h } -> do
      emit "("
      emitHole src ctx h
      emit ")"
    Just { value: AttrString t } -> emitFor t.range (stringLiteral (Entities.decode (unquote t.text)))
    _ -> failAt k.name.range "`key` needs a value: key=\"...\" or key={...}"
  emit " ("
  emitElement src ctx el
  emit ")"

emitElement :: Source -> Context -> Element Psx -> M Unit
emitElement src ctx el = do
  let
    tag = el.name.text
    ns = if tag == "svg" then Svg else ctx.namespace
    found = case HtmlData.element ns tag of
      Just e -> Just e
      Nothing -> HtmlData.element (other ns) tag
    namespace = maybe ns _.namespace found
    childCtx = ctx
      { namespace = if tag == "foreignObject" then Html else namespace
      , raw = tag == "script"
      , stamp = Nothing
      }
    children = items src childCtx el.children
    tagRange = { start: el.open.range.start, end: el.name.range.end }
    -- The scopes this element roots: its own `<style>`'s, and in a
    -- template, the file's.
    own = Array.find (\sc -> sc.at == el.open.range.start) ctx.scopes <#> \sc ->
      { code: Css.companionAlias <> "." <> Css.scopeName sc.index, range: sc.range }
    stamps = Array.fromFoldable ctx.stamp <> Array.fromFoldable own
  emitFor tagRange case found of
    Just e -> "B." <> e.purescript
    Nothing -> "B.element " <> stringLiteral tag
  emit " "
  emitAttrs src (ctx { stamp = Nothing }) namespace (tag <$ found) (Array.filter (not <<< isKey) el.attrs) stamps
  emit " "
  if Array.null children then do
    emit "B.none"
    for_ el.close \c -> padTo ctx { line: c.open.range.start.line, column: 0 }
  else do
    emit "("
    emitChildren src childCtx children
    for_ el.close \c -> padTo ctx { line: c.open.range.start.line, column: 0 }
    emit ")"
  where
  other Html = Svg
  other Svg = Html

  isKey = case _ of
    AttrNamed a -> a.name.text == "key"
    AttrTrait _ -> false

-- | `tag` is the element's name if the table has it. A custom element's
-- | attributes are all `B.attribute`. `stamps` are the scopes the element
-- | roots, each stamped as `data-psx`.
emitAttrs :: Source -> Context -> Namespace -> Maybe String -> Array (Attr Psx) -> Array { code :: String, range :: SourceRange } -> M Unit
emitAttrs src ctx ns tag attrs stamps
  | Array.null attrs && Array.null stamps = emit "[]"
  | otherwise = do
      emit "["
      forWithIndex_ attrs \i attr -> do
        emit (if i == 0 then " " else ", ")
        case attr of
          AttrNamed a -> do
            padTo ctx a.name.range.start
            emitAttr src ctx ns tag a
          -- One element of the array literal, so purs holds it to one `Attr`.
          AttrTrait h -> do
            padTo ctx h.open.range.start
            emitFor (holeRange h) "("
            emitHole src ctx h
            emit ")"
      forWithIndex_ stamps \i st -> do
        emit (if i == 0 && Array.null attrs then " " else ", ")
        emitFor st.range ("B.attribute \"data-psx\" " <> st.code)
      emit " ]"

emitAttr :: Source -> Context -> Namespace -> Maybe String -> NamedAttr Psx -> M Unit
emitAttr src ctx ns tag a = do
  let
    name = a.name.text
    range = attrRange a
  case HtmlData.eventByAttribute name of
    Just ev -> case a.value of
      Just { value: AttrHole h } -> withHole range ("B." <> ev.purescript) h
      _ -> failAt range ("An event handler is a hole: " <> name <> "={...}")
    Nothing -> case tag >>= \t -> HtmlData.elementAttribute ns t name <|> HtmlData.attribute ns name of
      Just attr -> case a.value of
        Just { value: AttrHole h } -> withHole range ("B." <> attr.purescript) h
        Just { value: AttrString t } -> literal range attr t
        Just { value: AttrRaw _ } -> pure unit
        Nothing -> case attr.valueType of
          BooleanValue -> emitFor range ("B." <> attr.purescript <> " true")
          IntegerValue -> failAt range ("`" <> name <> "` needs a number: " <> name <> "=\"1\" or " <> name <> "={...}")
          NumberValue -> failAt range ("`" <> name <> "` needs a number: " <> name <> "=\"1\" or " <> name <> "={...}")
          _ -> emitFor range ("B." <> attr.purescript <> " \"\"")
      Nothing -> do
        when (isJust tag && not (isJust (String.stripPrefix (String.Pattern "data-") name) || isJust (String.stripPrefix (String.Pattern "aria-") name))) do
          let
            candidates = HtmlData.attributeNames ns <> Array.mapMaybe (map _.attribute <<< HtmlData.event) HtmlData.eventNames
            nearest = Array.head (Array.sortWith _.score (map (\known -> { known, score: distance (String.toLower name) (String.toLower known) }) candidates))
            suggestion = case nearest of
              Just { known, score } | score <= 4 -> "; did you mean `" <> known <> "`?"
              _ -> ""
          modify_ \st -> st
            { warnings = Array.snoc st.warnings
                { range: a.name.range, message: "Unknown attribute `" <> name <> "`; passed through as a string attribute" <> suggestion, fix: Nothing }
            }
        let fn = "B.attribute " <> stringLiteral name
        case a.value of
          Just { value: AttrHole h } -> withHole range fn h
          Just { value: AttrString t } -> emitFor range (fn <> " " <> stringLiteral (Entities.decode (unquote t.text)))
          Just { value: AttrRaw _ } -> pure unit
          Nothing -> emitFor range (fn <> " \"\"")
  where
  withHole range fn h = do
    emitFor range (fn <> " (")
    emitHole src ctx h
    emit ")"

  literal range attr t = do
    let value = Entities.decode (unquote t.text)
    case attr.valueType of
      BooleanValue -> emitFor range ("B." <> attr.purescript <> " true")
      -- An `Int` literal.
      IntegerValue
        | isInteger value -> emitFor range ("B." <> attr.purescript <> " " <> parenthesise value)
        | otherwise -> failAt t.range ("`" <> a.name.text <> "` takes a whole number, not " <> show value)
      -- A `Number` literal, so `step="1"` is `1.0`.
      NumberValue
        | isNumber value -> emitFor range ("B." <> attr.purescript <> " " <> parenthesise (if isInteger value then value <> ".0" else value))
        | otherwise -> failAt t.range ("`" <> a.name.text <> "` takes a number, not " <> show value)
      _ -> emitFor range ("B." <> attr.purescript <> " " <> stringLiteral value)

attrRange :: NamedAttr Psx -> SourceRange
attrRange a =
  { start: a.name.range.start
  , end: case a.value of
      Nothing -> a.name.range.end
      Just { value: AttrString t } -> t.range.end
      Just { value: AttrHole h } -> h.close.range.end
      Just { value: AttrRaw t } -> t.range.end
  }

isNumber :: String -> Boolean
isNumber = Regex.test (Regex.unsafeRegex "^-?[0-9]+(\\.[0-9]+)?$" Regex.noFlags)

isInteger :: String -> Boolean
isInteger = Regex.test (Regex.unsafeRegex "^-?[0-9]+$" Regex.noFlags)

-- | A negative literal in parentheses, so it is one argument.
parenthesise :: String -> String
parenthesise value = if SCU.take 1 value == "-" then "(" <> value <> ")" else value

unquote :: String -> String
unquote s = SCU.drop 1 (SCU.dropRight 1 s)

-- | A PureScript string literal.
stringLiteral :: String -> String
stringLiteral s = "\"" <> String.joinWith "" (map char (String.toCodePointArray s)) <> "\""
  where
  char c = case String.singleton c of
    "\"" -> "\\\""
    "\\" -> "\\\\"
    "\n" -> "\\n"
    "\r" -> "\\r"
    "\t" -> "\\t"
    other
      | fromEnum c < 0x20 -> "\\x" <> Int.toStringAs Int.hexadecimal (fromEnum c)
      | otherwise -> other

-- Levenshtein distance, with one row of storage per character.
distance :: String -> String -> Int
distance a b = fromMaybe 0 (Array.last (Array.foldl step (Array.range 0 (SCU.length b)) (SCU.toCharArray a)))
  where
  step previous char = Array.foldl cell [ fromMaybe 0 (Array.head previous) + 1 ] (Array.mapWithIndex Tuple (SCU.toCharArray b))
    where
    cell row (Tuple i other) = Array.snoc row
      ( min
          (fromMaybe 0 (Array.index previous (i + 1)) + 1)
          (min (fromMaybe 0 (Array.last row) + 1) (fromMaybe 0 (Array.index previous i) + if char == other then 0 else 1))
      )
