type Lowered =
  { purs :: String
  , positionMap :: PositionMap
  }

-- | The modules a `.psx` file may take its markup functions from.
backendModules :: Array String
backendModules = [ "Portico.Psx", "Halogen.Psx", "Screamer.Psx", "Psx.Static" ]

-- | The first line of every generated file.
header :: String -> String
header sourceName = "-- Generated by psx from " <> sourceName

-- | Whether a `.purs` file's text is one psx wrote.
isGenerated :: String -> Boolean
isGenerated text = SCU.take 25 text == "-- Generated by psx from "

-- | `sourceName` is the name written in the header (the source's file
-- | name) and `generatedName` the name the position map gives the output.
lower :: { sourceName :: String, generatedName :: String } -> String -> Either (Array PsxError) Lowered
lower names text = case parseModule text of
  { module: Just m, errors: [] } -> lowerModule names (source text) m
  { errors } -> Left errors

-- The module -----------------------------------------------------------------

data Event
  -- | Insert text at an offset.
  = Insert Int String
  -- | Leave out the source from one offset to another.
  | Skip Int Int
  | Lower MarkupRoot

eventOffset :: Source -> Event -> Int
eventOffset src = case _ of
  Insert o _ -> o
  Skip o _ -> o
  Lower root -> offsetOf src (rootRange root).start

lowerModule :: { sourceName :: String, generatedName :: String } -> Source -> Module Psx -> Either (Array PsxError) Lowered
lowerModule names src m@(Module { header: ModuleHeader h, body: ModuleBody body }) = do
  let
    backends = Array.filter (\i -> Array.elem (importName i) backendModules) h.imports
    distinct = Array.nub (map importName backends)
  case distinct of
    [ backend ] -> do
      let
        roots = sortRoots (foldMapModule rootVisitor m)
        aliased = any (\i -> importName i == backend && isAlias i) backends
        needsAlias = not aliased && not (Array.null roots)
        importLine = maybe 0 (\i -> (rangeOf i).end.line) (Array.last backends)
        inserts =
          (if needsAlias then [ Insert (lineEnd src importLine) ("\nimport " <> backend <> " as B") ] else [])
        -- One blank line for the header, then one after the import.
        removable = removableLines src h body.decls
        skips = Array.catMaybes
          [ Array.head removable
          , if needsAlias then Array.find (\l -> l > importLine && Just l /= Array.head removable) removable else Nothing
          ] # map \l -> Skip (lineStart src l) (lineStart src (l + 1))
        events = Array.sortWith (eventOffset src) (inserts <> skips <> map Lower roots)
        st = execState
          ( do
              emit (header names.sourceName <> "\n")
              end <- runEvents src events 0
              copy src end (SCU.length src.text)
          )
          initial
      case st.errors of
        [] -> Right
          { purs: String.joinWith "" (Array.reverse (List.toUnfoldable st.chunks))
          , positionMap:
              { source: names.sourceName
              , generated: names.generatedName
              , segments: Array.reverse (List.toUnfoldable st.segments)
              }
          }
        errors -> Left errors
    [] -> Left [ moduleError h.name "A .psx file imports its backend: one of " (Array.intercalate ", " backendModules) ]
    _ -> Left
      [ moduleError h.name "A .psx file imports one backend, but this one imports " (Array.intercalate " and " distinct) ]
  where
  moduleError name message detail =
    { range: (rangeOf name), message: message <> detail, fix: Nothing }

importName :: forall e. ImportDecl e -> String
importName (ImportDecl i) = unwrap (unwrap i.module).name

isAlias :: forall e. ImportDecl e -> Boolean
isAlias (ImportDecl i) = case i.names, i.qualified of
  Nothing, Just (Tuple _ alias) -> unwrap (unwrap alias).name == "B"
  _, _ -> false

-- | Blank lines between the module header and the first declaration that no
-- | block comment spans, so they can go without changing the program.
removableLines :: forall r. Source -> { where :: SourceToken, imports :: Array (ImportDecl Psx) | r } -> Array (Declaration Psx) -> Array Int
removableLines src h decls = do
  let
    tokens = TokenList.toArray (foldMap' tokensOf h.imports)
      <> maybe [] (\d -> Array.take 1 (TokenList.toArray (tokensOf d))) (Array.head decls)
    gaps = Array.zipWith gap (Array.cons h.where tokens) tokens
    gap prev tok
      | any multiline tok.leadingComments = []
      | otherwise = Array.range (prev.range.end.line + 1) (tok.range.start.line - 1)
  Array.filter blank (Array.concat gaps)
  where
  foldMap' f = Array.foldl (\acc x -> acc <> f x) mempty
  multiline = case _ of
    Comment c -> String.contains (String.Pattern "\n") c
    _ -> false
  blank l = l >= 0 && Array.all isWhitespace (SCU.toCharArray (lineText src l)) && lineStart src (l + 1) > lineStart src l

lineStart :: Source -> Int -> Int
lineStart src l = fromMaybe (SCU.length src.text) (Array.index src.lineStarts l)

-- | The offset of the line feed that ends a line.
lineEnd :: Source -> Int -> Int
lineEnd src l = max (lineStart src l) (lineStart src (l + 1) - 1)

lineText :: Source -> Int -> String
lineText src l = SCU.slice (lineStart src l) (lineEnd src l) src.text

-- | Runs the events from an offset and returns the offset reached.
runEvents :: Source -> Array Event -> Int -> M Int
runEvents src events from = Array.foldM step from events
  where
  step at event = do
    let o = eventOffset src event
    copy src at o
    case event of
      Insert _ text -> emit text *> pure o
      Skip _ to -> pure to
      Lower root -> do
        lowerRoot src baseContext root
        pure (offsetOf src (rootRange root).end)

-- Emitting -------------------------------------------------------------------

type St =
  { chunks :: List String
  , line :: Int
  , column :: Int
  , segments :: List Segment
  , errors :: Array PsxError
  }

type M = State St

initial :: St
initial = { chunks: Nil, line: 0, column: 0, segments: Nil, errors: [] }

position :: M SourcePos
position = gets \st -> { line: st.line, column: st.column }

emit :: String -> M Unit
emit "" = pure unit
emit text = modify_ \st -> do
  let lines = String.split (String.Pattern "\n") text
  case Array.last lines of
    Just last | Array.length lines > 1 ->
      st { chunks = text : st.chunks, line = st.line + Array.length lines - 1, column = String.length last }
    _ -> st { chunks = text : st.chunks, column = st.column + String.length text }

-- | Emits code generated for the markup in a source range.
emitFor :: SourceRange -> String -> M Unit
emitFor range text = do
  start <- position
  emit text
  end <- position
  modify_ \st -> st { segments = { kind: Generated, generated: { start, end }, source: range } : st.segments }

-- | Copies the source between two offsets.
copy :: Source -> Int -> Int -> M Unit
copy src from to = when (from < to) do
  let text = SCU.slice from to src.text
  when (SCU.take 1 text == "\n" || SCU.take 2 text == "\r\n") trimTrailingSpaces
  start <- position
  emit text
  end <- position
  let range = { start: posOf src from, end: posOf src to }
  modify_ \st -> st { segments = { kind: Copy, generated: { start, end }, source: range } : st.segments }

failAt :: SourceRange -> String -> M Unit
failAt range message = modify_ \st -> st { errors = Array.snoc st.errors { range, message, fix: Nothing } }

-- | What the code for one literal needs to know about where it sits.
type Context =
  { -- | Generated line minus source line where the literal starts.
    delta :: Int
  -- | The least indentation of a line the lowering starts, which keeps
  -- | it inside the layout block the literal is in.
  , indent :: Int
  , namespace :: Namespace
  , raw :: Boolean
  }

baseContext :: Context
baseContext = { delta: 0, indent: 1, namespace: Html, raw: false }

-- | Moves to the source position's line (as it maps to the generated file),
-- | and on that line to its column if that is still ahead.
padTo :: Context -> SourcePos -> M Unit
padTo ctx pos = do
  st <- get
  let target = pos.line + ctx.delta
  if st.line < target then do
    trimTrailingSpaces
    emit (power "\n" (target - st.line) <> power " " (max pos.column ctx.indent))
  else if st.column < pos.column then emit (power " " (pos.column - st.column))
  else pure unit

power :: String -> Int -> String
power s n = if n <= 0 then "" else s <> power s (n - 1)

-- | Drops the spaces this lowering left at the end of the line so far.
trimTrailingSpaces :: M Unit
trimTrailingSpaces = modify_ \st -> case st.chunks of
  chunk : rest -> do
    let n = SCU.length chunk - SCU.length (dropTrailing chunk)
    if n > 0 && SCU.take 1 chunk /= "" then st { chunks = SCU.dropRight n chunk : rest, column = st.column - n } else st
  _ -> st
  where
  dropTrailing c = if SCU.takeRight 1 c == " " then dropTrailing (SCU.dropRight 1 c) else c

-- Markup ---------------------------------------------------------------------

rootVisitor :: { onBinder :: Binder Psx -> Array MarkupRoot, onDecl :: Declaration Psx -> Array MarkupRoot, onExpr :: Expr Psx -> Array MarkupRoot, onType :: CST.Type Psx -> Array MarkupRoot }
rootVisitor = defaultMonoidalVisitor
  { onExpr = case _ of
      ExprError (PsxMarkup root) -> [ root ]
      _ -> []
  }

-- | The literals in an expression, not counting those inside them.
rootsIn :: Expr Psx -> Array MarkupRoot
rootsIn = sortRoots <<< foldMapExpr rootVisitor

sortRoots :: Array MarkupRoot -> Array MarkupRoot
sortRoots = Array.sortWith \r -> let s = (rootRange r).start in [ s.line, s.column ]

rootRange :: MarkupRoot -> SourceRange
rootRange root = rangeOf (PsxMarkup root)

lowerRoot :: Source -> Context -> MarkupRoot -> M Unit
lowerRoot src outer root = do
  st <- get
  let
    start = (rootRange root).start
    ctx = outer
      { delta = st.line - start.line
      , indent = max outer.indent (firstColumn src start.line + 1)
      }
  case root.markup of
    MarkupElement el
      | Just k <- keyOf el -> do
          emit "[ "
          emitKeyed src ctx k el
          emit " ]"
      | otherwise -> do
          emit "[ "
          emitElement src ctx el
          emit " ]"
    MarkupFragment fr -> do
      emitChildren src ctx (items src ctx fr.children)
      -- Back to the line the literal ends on, so the source after it keeps
      -- its line.
      padTo ctx { line: (rootRange root).end.line, column: 0 }

-- | The column of the first character on a line that is not whitespace.
firstColumn :: Source -> Int -> Int
firstColumn src l = String.length (SCU.takeWhile isWhitespace (lineText src l))

-- | A hole's expression, with the literals in it lowered in turn.
emitHole :: Source -> Context -> Hole Psx -> M Unit
emitHole src ctx h = do
  let range = rangeOf h.expr
  padTo ctx range.start
  end <- runEvents' (rootsIn h.expr) (offsetOf src range.start)
  copy src end (offsetOf src range.end)
  where
  runEvents' roots from = Array.foldM step from roots
  step at root = do
    copy src at (offsetOf src (rootRange root).start)
    lowerRoot src ctx root
    pure (offsetOf src (rootRange root).end)

data Item
  -- | Text after the whitespace policy, and where it starts.
  = ItemText MToken SourcePos String
  | ItemElement (Element Psx)
  | ItemHole (Hole Psx)

-- | The children that make nodes: fragments are spliced, comments and
-- | whitespace that the policy removes are dropped.
items :: Source -> Context -> Array (Child Psx) -> Array Item
items src ctx = Array.concatMap case _ of
  ChildText t -> do
    let text = if ctx.raw then t.text else Entities.decode (Whitespace.normalise t.text)
    if text == "" then []
    else do
      let lead = SCU.length (SCU.takeWhile isWhitespace t.text)
      [ ItemText t (posOf src (offsetOf src t.range.start + if ctx.raw then 0 else lead)) text ]
  ChildMarkup (MarkupElement el) -> [ ItemElement el ]
  ChildMarkup (MarkupFragment fr) -> items src ctx fr.children
  ChildHole h -> [ ItemHole h ]
  ChildComment _ -> []
  ChildRaw _ -> []

-- | Whether children are a keyed list: some child element carries `key`,
-- | or some hole holds a literal that does.
keyedItems :: Source -> Context -> Array Item -> Boolean
keyedItems src ctx = any case _ of
  ItemElement el -> isJust (keyOf el)
  ItemHole h -> any (rootKeyed src ctx) (rootsIn h.expr)
  ItemText _ _ _ -> false

rootKeyed :: Source -> Context -> MarkupRoot -> Boolean
rootKeyed src ctx root = case root.markup of
  MarkupElement el -> isJust (keyOf el)
  MarkupFragment fr -> keyedItems src ctx (items src ctx fr.children)

keyOf :: Element Psx -> Maybe (Attr Psx)
keyOf el = Array.find (\a -> a.name.text == "key") el.attrs

-- | Children as one expression: runs of nodes in array literals, holes
-- | through `B.children`, joined with `<>`.
emitChildren :: Source -> Context -> Array Item -> M Unit
emitChildren src ctx children = do
  let keyedList = keyedItems src ctx children
  if Array.null children then emit "[]"
  else do
    inArray <- Array.foldM (step keyedList) Nothing (Array.mapWithIndex Tuple children)
    when (inArray == Just true) (emit " ]")
  where
  -- Nothing before the first item; then whether an array literal is open.
  step keyedList open (Tuple _ item) = case item of
    ItemHole h -> do
      when (open == Just true) (emit " ]")
      when (isJust open) (emit " <>")
      emit (if isJust open then " " else "")
      emitFor (holeRange h) (if keyedList then "B.keyedChildren (" else "B.children (")
      emitHole src ctx h
      emit ")"
      pure (Just false)
    _ -> do
      case open of
        Just true -> emit ","
        Just false -> emit " <> ["
        Nothing -> emit "["
      emit " "
      case item of
        ItemText t start text -> do
          padTo ctx start
          if keyedList then failAt t.range "Text cannot be a child of a keyed list: every child must carry `key`"
          else emitFor t.range ("B.text " <> stringLiteral text)
        ItemElement el -> do
          padTo ctx el.open.range.start
          case keyOf el of
            Just k -> emitKeyed src ctx k el
            Nothing -> do
              when keyedList (failAt el.name.range "This element is in a keyed list, so it must carry `key` as its siblings do")
              emitElement src ctx el
        ItemHole _ -> pure unit
      pure (Just true)

holeRange :: Hole Psx -> SourceRange
holeRange h = { start: h.open.range.start, end: h.close.range.end }

emitKeyed :: Source -> Context -> Attr Psx -> Element Psx -> M Unit
emitKeyed src ctx k el = do
  emitFor k.name.range "B.keyed "
  case k.value of
    Just { value: AttrHole h } -> do
      emit "("
      emitHole src ctx h
      emit ")"
    Just { value: AttrString t } -> emitFor t.range (stringLiteral (Entities.decode (unquote t.text)))
    _ -> failAt k.name.range "`key` needs a value: key=\"...\" or key={...}"
  emit " ("
  emitElement src ctx el
  emit ")"

emitElement :: Source -> Context -> Element Psx -> M Unit
emitElement src ctx el = do
  let
    tag = el.name.text
    ns = if tag == "svg" then Svg else ctx.namespace
    found = case HtmlData.element ns tag of
      Just e -> Just e
      Nothing -> HtmlData.element (other ns) tag
    namespace = maybe ns _.namespace found
    childCtx = ctx
      { namespace = if tag == "foreignObject" then Html else namespace
      , raw = tag == "script" || tag == "style"
      }
    children = items src childCtx el.children
    keyedList = keyedItems src childCtx children
    tagRange = { start: el.open.range.start, end: el.name.range.end }
  emitFor tagRange case found of
    _ | keyedList -> "B.keyedElement " <> stringLiteral tag
    Just e -> "B." <> e.purescript
    Nothing -> "B.element " <> stringLiteral tag
  emit " "
  emitAttrs src ctx namespace (tag <$ found) (Array.filter (\a -> a.name.text /= "key") el.attrs)
  emit " "
  if Array.null children then emit "[]"
  else do
    emit "("
    emitChildren src childCtx children
    for_ el.close \c -> padTo ctx { line: c.open.range.start.line, column: 0 }
    emit ")"
  where
  other Html = Svg
  other Svg = Html

-- | `tag` is the element's name if the table has it. A custom element's
-- | attributes are all `B.attribute`.
emitAttrs :: Source -> Context -> Namespace -> Maybe String -> Array (Attr Psx) -> M Unit
emitAttrs src ctx ns tag attrs
  | Array.null attrs = emit "[]"
  | otherwise = do
      emit "["
      forWithIndex_ attrs \i a -> do
        emit (if i == 0 then " " else ", ")
        padTo ctx a.name.range.start
        emitAttr src ctx ns tag a
      emit " ]"

emitAttr :: Source -> Context -> Namespace -> Maybe String -> Attr Psx -> M Unit
emitAttr src ctx ns tag a = do
  let
    name = a.name.text
    range = attrRange a
  case HtmlData.eventByAttribute name of
    Just ev -> case a.value of
      Just { value: AttrHole h } -> withHole range ("B." <> ev.purescript) h
      _ -> failAt range ("An event handler is a hole: " <> name <> "={...}")
    Nothing -> case tag >>= \t -> HtmlData.elementAttribute ns t name <|> HtmlData.attribute ns name of
      Just attr -> case a.value of
        Just { value: AttrHole h } -> withHole range ("B." <> attr.purescript) h
        Just { value: AttrString t } -> literal range attr t
        Just { value: AttrRaw _ } -> pure unit
        Nothing -> case attr.valueType of
          BooleanValue -> emitFor range ("B." <> attr.purescript <> " true")
          NumberValue -> failAt range ("`" <> name <> "` needs a number: " <> name <> "=\"1\" or " <> name <> "={...}")
          _ -> emitFor range ("B." <> attr.purescript <> " \"\"")
      Nothing -> do
        let fn = "B.attribute " <> stringLiteral name
        case a.value of
          Just { value: AttrHole h } -> withHole range fn h
          Just { value: AttrString t } -> emitFor range (fn <> " " <> stringLiteral (Entities.decode (unquote t.text)))
          Just { value: AttrRaw _ } -> pure unit
          Nothing -> emitFor range (fn <> " \"\"")
  where
  withHole range fn h = do
    emitFor range (fn <> " (")
    emitHole src ctx h
    emit ")"

  literal range attr t = do
    let value = Entities.decode (unquote t.text)
    case attr.valueType of
      BooleanValue -> emitFor range ("B." <> attr.purescript <> " true")
      NumberValue
        | isNumber value -> emitFor range ("B." <> attr.purescript <> " " <> if SCU.take 1 value == "-" then "(" <> value <> ")" else value)
        | otherwise -> failAt t.range ("`" <> a.name.text <> "` takes a number, not " <> show value)
      _ -> emitFor range ("B." <> attr.purescript <> " " <> stringLiteral value)

attrRange :: Attr Psx -> SourceRange
attrRange a =
  { start: a.name.range.start
  , end: case a.value of
      Nothing -> a.name.range.end
      Just { value: AttrString t } -> t.range.end
      Just { value: AttrHole h } -> h.close.range.end
      Just { value: AttrRaw t } -> t.range.end
  }

isNumber :: String -> Boolean
isNumber = Regex.test (Regex.unsafeRegex "^-?[0-9]+(\\.[0-9]+)?$" Regex.noFlags)

unquote :: String -> String
unquote s = SCU.drop 1 (SCU.dropRight 1 s)

-- | A PureScript string literal.
stringLiteral :: String -> String
stringLiteral s = "\"" <> String.joinWith "" (map char (String.toCodePointArray s)) <> "\""
  where
  char c = case String.singleton c of
    "\"" -> "\\\""
    "\\" -> "\\\\"
    "\n" -> "\\n"
    "\r" -> "\\r"
    "\t" -> "\\t"
    other
      | fromEnum c < 0x20 -> "\\x" <> Int.toStringAs Int.hexadecimal (fromEnum c)
      | otherwise -> other
